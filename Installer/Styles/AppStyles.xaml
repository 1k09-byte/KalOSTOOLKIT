<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KalOS.Setup.Converters">

    <!-- ═══════════════════════════════════════════════════════════
         Semantic color layer — mirrors the main app's Brushes.xaml.
         We rely 100% on the platform's built-in ThemeResource brushes
         for all surfaces (proper dark/light), keeping only brand + status.
         ═══════════════════════════════════════════════════════════ -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AccentColor">#60CDFF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#0F0F0F" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="InfoBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9D9D9D" />

        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AccentColor">#0078D4</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="InfoBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#5C5C5C" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <converters:BoolToVisibilityConverter x:Key="BoolToVis" />

    <!-- ═══════════════════════════════════════════════════════════
         Design tokens — Windows 11 Settings spacing
         ═══════════════════════════════════════════════════════════ -->
    <x:Double x:Key="PageContentMaxWidth">760</x:Double>
    <Thickness x:Key="PagePadding">40,32,40,24</Thickness>
    <Thickness x:Key="SectionMargin">0,0,0,24</Thickness>

    <!-- ═══════════════════════════════════════════════════════════
         Typography — strict aliases over the WinUI type ramp
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="WizardPageRoot" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
        <!-- Transparent so the shell's Mica backdrop shows through. -->
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Shell typography — small uppercase kicker + big dashboard title -->
    <Style x:Key="ShellCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- TitleTextBlockStyle is the WinUI 3 page-title size (28). -->
    <Style x:Key="ShellTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,28" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Content cards — the Windows 11 Settings "card" look
         ═══════════════════════════════════════════════════════════ -->
    <!-- Cards use the platform's standard card resources (WinUI Gallery look) -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Clickable dashboard card (Home page) -->
    <Style x:Key="HomeCardButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- "Install" entry pinned to the NavigationView pane footer. Looks like
         a nav page row (transparent + subtle hover fill) but is a real Button. -->
    <Style x:Key="NavPaneButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="CardSubtitle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         List containers — stretch so card content fills the row
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="StretchListViewItem" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Buttons — accent primary, plain secondary (native WinUI look)
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="120" />
    </Style>
</ResourceDictionary>
