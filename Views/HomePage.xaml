<Page
    x:Class="KalOS.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KalOS.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:KalOS.Views"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid>
            <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch"
                        Spacing="24"
                        Margin="{StaticResource PagePadding}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <!-- ═══════════ MODULES GRID ═══════════
                     WinUI card pattern (Dev Home / Settings): left-aligned
                     icon + title row, description indented under the title.
                     All sizing/type ramp comes from the shared text styles. -->
                <TextBlock Text="What’s inside" Style="{StaticResource SectionLabelStyle}" />
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CompactActionTileStyle}" Click="NavigateCard_Click" Tag="ProcessControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="110">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="Process Control" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Per-process priorities, AutoBalance, and restart-on-change rules."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="30,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CompactActionTileStyle}" Click="NavigateCard_Click" Tag="AffinityManager" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="110">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="Per-CPU Scheduling" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Pin device interrupts to dedicated cores, MSI mode, IRQ policies."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="30,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CompactActionTileStyle}" Click="NavigateCard_Click" Tag="GpuDrivers" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="110">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="GPU Drivers" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Latest NVIDIA / AMD drivers — stripped, silent, painless."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="30,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CompactActionTileStyle}" Click="NavigateCard_Click" Tag="Browsers" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="110">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="Browsers &amp; Software" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Silent installs via winget, Chocolatey, Scoop, or direct download."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="30,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactActionTileStyle}" Click="NavigateCard_Click" Tag="AdditionalTweaks" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="110">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="Additional Tweaks" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Debloat, privacy, and deep OS behavior tuning."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="30,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CompactActionTileStyle}" Click="NavigateCard_Click" Tag="Bios" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="110">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7F8;" FontSize="18" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="BIOS Manager" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Read your board's BIOS state and update safely."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="30,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ═══════════ QUICK LINKS ROW ═══════════ -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource CompactActionTileStyle}" MinHeight="56" Command="{x:Bind ViewModel.OpenDeviceManagerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9F3;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Device Manager" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource CompactActionTileStyle}" MinHeight="56" Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Windows Settings" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource CompactActionTileStyle}" MinHeight="56" Click="JoinDiscord_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8F2;" FontSize="16" Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Text="Join the Discord" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
