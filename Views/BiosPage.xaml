<Page
    x:Class="KalOS.Views.BiosPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KalOS.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid>
        <ScrollViewer Style="{StaticResource PageScrollStyle}">
            <Grid>
                <StackPanel MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch"
                            Spacing="{StaticResource SettingsCardSpacing}"
                            Margin="{StaticResource PagePadding}">
                    <StackPanel.ChildrenTransitions>
                        <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>

                    <StackPanel Spacing="4" Margin="0,0,0,6">
                        <TextBlock Text="BIOS Settings" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Browse and edit BIOS/UEFI NVRAM settings via AMI SCEWIN."
                                   Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>


                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                             Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                    <InfoBar IsOpen="{x:Bind ViewModel.BiosLocked, Mode=OneWay}" Severity="Warning"
                             Title="BIOS Locked / Password Required"
                             Message="{x:Bind ViewModel.LockMessage, Mode=OneWay}" />

                    <TextBlock Text="System Information" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                    <controls:SettingsCard Header="Hardware"
                                           Description="{x:Bind ViewModel.HardwareLine, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.VendorStatus, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <!-- Action Bar -->
                    <Grid ColumnSpacing="12" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <AutoSuggestBox Grid.Column="0" PlaceholderText="Search settings…"
                                        QueryIcon="Find" VerticalAlignment="Center" MaxWidth="500" HorizontalAlignment="Left"
                                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Column="1" Content="Show edited only"
                                  IsChecked="{x:Bind ViewModel.ShowChangesOnly, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            
                            <Button Command="{x:Bind ViewModel.RefreshCommand}"
                                    IsEnabled="{x:Bind ViewModel.RefreshEnabled, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Export" />
                                </StackPanel>
                            </Button>

                            <Button Click="ApplyConfirmation_Click" Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.ApplyEnabled, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    <TextBlock Text="Apply" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}">
                        <Run Text="Settings (" /><Run Text="{x:Bind ViewModel.SettingsCount, Mode=OneWay}" /><Run Text=" shown)" />
                    </TextBlock>

                    <!-- Settings list — uses ListView for UI-virtualisation -->
                    <ListView ItemsSource="{x:Bind ViewModel.FilteredSettings}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              MaxHeight="600"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BiosSettingViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="400" />
                                    <Border x:Name="SecurityWarningBorder" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            CornerRadius="4" Padding="6,1"
                                            x:Load="{x:Bind IsSensitiveVisible}">
                                        <TextBlock Text="security" FontSize="10"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>
                                    <Border x:Name="EditedWarningBorder" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            CornerRadius="4" Padding="6,1"
                                            x:Load="{x:Bind IsDirtyVisible, Mode=OneWay}">
                                        <TextBlock Text="edited" FontSize="10"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0">
                                    <ComboBox x:Name="EnumEditor" ItemsSource="{x:Bind DisplayOptions}"
                                              SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                                              x:Load="{x:Bind IsEnum}"
                                              HorizontalAlignment="Stretch" />

                                    <NumberBox x:Name="IntEditor" Value="{x:Bind EditedInt, Mode=TwoWay}"
                                               SpinButtonPlacementMode="Compact"
                                               x:Load="{x:Bind IsInteger}"
                                               HorizontalAlignment="Stretch" />

                                    <TextBox x:Name="StringEditor" Text="{x:Bind EditedString, Mode=TwoWay}"
                                             x:Load="{x:Bind IsTextEditor}"
                                             FontFamily="Consolas" HorizontalAlignment="Stretch" />
                                </Grid>
                                
                                <Button Grid.Column="1" x:Name="TechnicalDetailsButton" Content="T" 
                                        ToolTipService.ToolTip="Technical details"
                                        VerticalAlignment="Center"
                                        x:Load="{x:Bind HasDescription}">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <ScrollViewer MaxHeight="360" MaxWidth="380"
                                                          Padding="0,0,12,0"
                                                          FontSize="12" Margin="0,4,0,0"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          HorizontalScrollMode="Disabled"
                                                          VerticalScrollBarVisibility="Auto"
                                                          VerticalScrollMode="Auto"
                                                          ZoomMode="Disabled">
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            </ListView>

        <!-- Pending changes -->

        <controls:SettingsExpander Header="Pending Changes"
                                   Description="Settings staged to be written to NVRAM upon Apply."
                                   IsExpanded="False"
                                   ItemsSource="{x:Bind ViewModel.PendingChanges}"
                                   Visibility="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE81D;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Content>
                <TextBlock Text="{x:Bind ViewModel.PendingChanges.Count, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </controls:SettingsExpander.Content>
            <controls:SettingsExpander.ItemTemplate>
                <DataTemplate x:DataType="vm:BiosDiffItem">
                    <controls:SettingsCard>
                        <controls:SettingsCard.Content>
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" MinWidth="0" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind CurrentValue}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontFamily="Consolas" FontSize="12" />
                                <FontIcon Grid.Column="3" Glyph="&#xE72A;" FontSize="12" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ProposedValue}" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Grid>
                        </controls:SettingsCard.Content>
                    </controls:SettingsCard>
                </DataTemplate>
            </controls:SettingsExpander.ItemTemplate>
        </controls:SettingsExpander>

        <!-- Backups -->
        <controls:SettingsExpander Header="Firmware Backups"
                                   Description="Snapshots captured before writing changes."
                                   IsExpanded="False"
                                   ItemsSource="{x:Bind ViewModel.Backups}">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8F1;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Content>
                <TextBlock Text="{x:Bind ViewModel.Backups.Count, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </controls:SettingsExpander.Content>
            <controls:SettingsExpander.ItemTemplate>
                <DataTemplate>
                    <controls:SettingsCard>
                        <controls:SettingsCard.Content>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" />
                        </controls:SettingsCard.Content>
                    </controls:SettingsCard>
                </DataTemplate>
            </controls:SettingsExpander.ItemTemplate>
        </controls:SettingsExpander>

    </StackPanel>
    </Grid>
    </ScrollViewer>
    </Grid>
</Page>