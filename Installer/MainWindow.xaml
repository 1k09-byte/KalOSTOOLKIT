<Window
    x:Class="KalOS.Setup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- extended title bar -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ App title bar (WinUI Gallery pattern — set as the drag region) ══ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock x:Name="TitleBarText" FontSize="12" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- ══ Shell: NavigationView pane + wizard content ═════════════════ -->
        <Grid Grid.Row="1">
            <NavigationView x:Name="NavView"
                            PaneDisplayMode="Left"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            IsPaneToggleButtonVisible="False"
                            OpenPaneLength="232"
                            SelectionChanged="NavView_SelectionChanged">

                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="0">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="GPU Drivers" Tag="1">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7F4;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Browsers &amp; Software" Tag="2">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE774;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Customize" Tag="3">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE790;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <!-- Pinned install entry — styled like a nav page row, still a Button -->
                <NavigationView.PaneFooter>
                    <StackPanel Margin="4,0,4,10">
                        <Button x:Name="InstallPaneButton" Style="{StaticResource NavPaneButton}"
                                Click="InstallPaneButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE896;" FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Install KalOS" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </NavigationView.PaneFooter>

                <!-- Wizard content: pages + nav footer -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Frame x:Name="WizardFrame" Grid.Row="0" Padding="0"/>

                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" Padding="24,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}"
                                    Click="BackButton_Click" Visibility="Collapsed">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Back" Modifiers="Menu"/>
                                </Button.KeyboardAccelerators>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" HorizontalAlignment="Right">
                                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                                        Click="CancelButton_Click"/>
                                <Button x:Name="NextButton" Content="Next" Style="{StaticResource AccentButton}"
                                        Click="NextButton_Click">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="Enter"/>
                                    </Button.KeyboardAccelerators>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>