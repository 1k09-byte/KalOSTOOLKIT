<Page
    x:Name="RootPage"
    x:Class="KalOS.Views.GpuDriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KalOS.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">


    <Grid>
        <ScrollViewer Style="{StaticResource PageScrollStyle}">
            <Grid>
                <StackPanel MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch"
                            Spacing="16"
                            Margin="{StaticResource PagePadding}">

                    <!-- Page Header with Integrated Refresh Button -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="GPU Drivers" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Automatic detection, debloated installation, and graphics driver optimization."
                                       Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>

                        <!-- Header Refresh Button -->
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <FontIcon Glyph="&#xE72C;" FontSize="14"
                                          Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Text="Check" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <InfoBar
                        x:Name="ErrorInfoBar"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error"
                        CloseButtonClick="ErrorInfoBar_CloseClick" />

                    <!-- Live Background Installation Banner -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.IsInstalling, Mode=OneWay}"
                        Severity="Informational"
                        Title="Background installation in progress…"
                        Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        IsClosable="False">
                        <InfoBar.Content>
                            <ProgressBar IsIndeterminate="True" Margin="0,8,0,4" HorizontalAlignment="Stretch" />
                        </InfoBar.Content>
                    </InfoBar>

                    <!-- Main GPU Cards (Hero Section) -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Gpus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GpuDriverItem">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,8">
                                    <StackPanel Spacing="14">
                                        <!-- Row 1: Name, and Status Badge -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>


                                            <!-- GPU Name & Version info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
                                                    <!-- Laptop detection badge (chassis type / mobile model name) -->
                                                    <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind ShowLaptopBadge, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE7F4;" FontSize="10"
                                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                            <TextBlock Text="{x:Bind LaptopBadgeText, Mode=OneWay}" FontSize="10.5"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind InstalledText, Mode=OneWay}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               Visibility="{x:Bind HasLatestText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{x:Bind LatestText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                               Visibility="{x:Bind HasLatestText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" Style="{StaticResource StatusBadgeStyle}"
                                                    Visibility="{x:Bind ShowStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="12"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 2: Single Dynamic Action Button & Options Dropdown -->
                                        <StackPanel Orientation="Horizontal" Spacing="10"
                                                    Visibility="{x:Bind ShowStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <!-- Single Dynamic Primary Action Button -->
                                            <Button Click="PrimaryAction_Click" Tag="{Binding}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Visibility="{x:Bind CanAutoInstall, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind PrimaryActionGlyph, Mode=OneWay}" FontSize="14" />
                                                    <TextBlock Text="{x:Bind PrimaryActionText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Context Options DropDown -->
                                            <DropDownButton Content="Options" Visibility="{x:Bind ShowOpenPage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                <DropDownButton.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="Clean Uninstall (AMD Cleanup Utility)"
                                                                        Click="RunAmdCleanup_Click"
                                                                        Visibility="{x:Bind IsAmd, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>

                                                        <MenuFlyoutItem Text="Official AMD Auto-Detect Program"
                                                                        Click="RunAmdAutoDetect_Click"
                                                                        Visibility="{x:Bind IsAmd, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE896;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>

                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Install Notebook Version (Laptops)"
                                                                        Click="InstallAmdNotebook_Click"
                                                                        Visibility="{x:Bind IsAmd, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE7F4;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>

                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Visit Official Website"
                                                                        Click="OpenPage_Click" Tag="{Binding}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8A7;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                        </StackPanel>

                                        <!-- Busy Progress Indicator -->
                                        <StackPanel Spacing="6" Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{x:Bind BusyText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ProgressBar Maximum="100"
                                                         Value="{x:Bind ProgressValue, Mode=OneWay}"
                                                         IsIndeterminate="{x:Bind ProgressIndeterminate, Mode=OneWay}"
                                                         HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No compatible graphics adapters were detected."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.HasNoGpus, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <!-- Optimization & Maintenance Section -->
                    <TextBlock Text="Optimization &amp; Maintenance" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="0,6,0,0" />

                    <!-- Native AMD Post-Install Debloat Card -->
                    <controls:SettingsCard Header="Purge AMD Telemetry (Post-Install)"
                                           Description="Disables background telemetry services (Crash Defender, External Events, AUEP) and clears residual caches.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Command="{x:Bind ViewModel.RunAmdPostInstallDebloatCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSlimming, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsSlimming, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Purge Telemetry" Visibility="{x:Bind ViewModel.IsSlimming, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Text="Cleaning…" Visibility="{x:Bind ViewModel.IsSlimming, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Button>
                    </controls:SettingsCard>

                    <!-- AMD Notebook Package Card (AMD adapters only) -->
                    <controls:SettingsCard Visibility="{x:Bind ViewModel.HasAmdGpu, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                           Header="Install Notebook Version (Laptops)"
                                           Description="Installs the AMD Adrenalin package with desktop + notebook INFs (the 'combined' build). For laptop iGPUs/dGPUs the desktop package rejects — the installer detects hardware the desktop INF doesn't cover.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Command="{x:Bind ViewModel.InstallAmdNotebookDriverCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsInstalling, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Install" Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Text="Installing…" Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Button>
                    </controls:SettingsCard>

                    <!-- GPU Audio Controller Card -->
                    <controls:SettingsCard Header="GPU HDMI / DisplayPort Audio Controller"
                                           Description="Disables the GPU's HDMI/DP audio controller in Device Manager to reduce DPC latency (recommended when using headphones or a dedicated DAC).">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE767;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsGpuAudioEnabled, Mode=OneWay}"
                                      Toggled="GpuAudio_Toggled"
                                      OnContent="Enabled" OffContent="Disabled (DPC Optimized)" />
                    </controls:SettingsCard>

                    <!-- Official AMD Auto-Detect Card -->
                    <controls:SettingsCard Header="Official AMD Auto-Detect Installer"
                                           Description="Downloads and executes the official AMD Auto-Detect tool with strict Authenticode verification.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Command="{x:Bind ViewModel.UpdateAmdOfficialCommand}"
                                 IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsAutoDetecting, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsAutoDetecting, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Launch Auto-Detect" Visibility="{x:Bind ViewModel.IsAutoDetecting, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Text="Checking…" Visibility="{x:Bind ViewModel.IsAutoDetecting, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Button>
                    </controls:SettingsCard>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

