<winuiex:WindowEx
    x:Class="KalOS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    mc:Ignorable="d"
    Title="KalOS (update test)"
    Width="1200"
    Height="820"
    MinWidth="900"
    MinHeight="620">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Background image layer (behind everything) -->
        <Image x:Name="BackgroundImage"
               Grid.Row="0" Grid.RowSpan="2"
               Stretch="UniformToFill"
               Opacity="0.5"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Collapsed" />

        <!-- Semi-transparent overlay to keep content readable -->
        <Grid x:Name="BackgroundOverlay"
              Grid.Row="0" Grid.RowSpan="2"
              Background="#80000000"
              Visibility="Collapsed" />

        <!-- Title bar with integrated search -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="KalOS (update test)"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.Content>
                <AutoSuggestBox x:Name="ToolSearchBox"
                                Width="420"
                                PlaceholderText="Search tools…"
                                QueryIcon="Find"
                                QuerySubmitted="ToolSearchBox_QuerySubmitted"
                                HorizontalAlignment="Center" />
            </TitleBar.Content>
        </TitleBar>

        <!-- Navigation shell — flattened to 2 levels max -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="641"
                        ExpandedModeThresholdWidth="1008"
                        IsPaneOpen="True"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Auto"
                        IsSettingsVisible="False"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        ItemInvoked="NavView_ItemInvoked"
                        BackRequested="NavView_BackRequested">
            <NavigationView.MenuItems>
                <!-- ─── Overview ─── -->
                <NavigationViewItem Content="Home" Tag="Home" />
                <NavigationViewItem Content="System Overview" Tag="SystemOverview" />

                <NavigationViewItem Content="Browsers &amp; Software" Tag="Browsers" />
                <NavigationViewItem Content="GPU Drivers" Tag="GpuDrivers" />
                <NavigationViewItem Content="Other Drivers" Tag="Sdio" />
                <NavigationViewItem Content="BIOS Manager" Tag="Bios" />
                <NavigationViewItem Content="Per-CPU Scheduling" Tag="AffinityManager" />
                <NavigationViewItem Content="Personalization" Tag="Personalization" />
                <NavigationViewItem Content="Additional Tweaks" Tag="AdditionalTweaks" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" PointerWheelChanged="ContentFrame_PointerWheelChanged"
                   ContentTransitions="{StaticResource PageNavigationTransition}" />
        </NavigationView>

        <!-- Full-window modal overlay container for perfectly centered custom dialogs -->
        <Grid x:Name="AppModalOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Background="#80000000"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <ContentControl x:Name="AppModalContent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>

    </Grid>
</winuiex:WindowEx>
