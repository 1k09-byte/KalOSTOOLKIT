<UserControl
    x:Class="KalOS.Views.MetricRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="180"
    Height="180">
    <Grid>
        <ProgressRing Width="154"
                      Height="154"
                      Value="{x:Bind Progress, Mode=OneWay}"
                      IsIndeterminate="False"
                      IsEnabled="True"
                      Foreground="{x:Bind RingBrush, Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind ValueText, Mode=OneWay}"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
