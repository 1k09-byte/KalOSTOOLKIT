<ContentDialog
    x:Class="KalOS.Views.NvTweaksDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Installation Tweaks"
    PrimaryButtonText="Install"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource RoundedContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MaxHeight="560">

        <TextBlock Text="Optional post-install tweaks, applied after the driver is in place. Each step is best-effort — anything already absent is skipped safely."
                   TextWrapping="Wrap" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <StackPanel Spacing="6">
            <CheckBox x:Name="CbDisableTelemetry" Content="Disable driver telemetry" IsChecked="True"
                      ToolTipService.ToolTip="SendTelemetryData=0, FTS RID flags off, Control Panel opt-out, nvlddmkm\NvCamera key removed." />
            <CheckBox x:Name="CbUninstallVisionAnsel" Content="Uninstall 3D Vision, Ansel &amp; driver-audio leftovers" IsChecked="True"
                      ToolTipService.ToolTip="Best-effort Installer2 uninstall of Display.3DVision / Display.Audio / Ansel from a previous full install. Fresh installs already strip them." />
            <CheckBox x:Name="CbDisableTasks" Content="Disable NVIDIA telemetry &amp; update scheduled tasks" IsChecked="True"
                      ToolTipService.ToolTip="NvTmMon/NvTmRep, NvProfile, NvNodeLauncher, NvDriverUpdateCheckDaily, NvBatteryBoostCheckOnLogon, GFE SelfUpdate — disabled, not deleted." />
            <CheckBox x:Name="CbNvBackendStartup" Content="Remove NvBackend from startup" IsChecked="True"
                      ToolTipService.ToolTip="Deletes the NvBackend entry from the current user's Run key." />
            <CheckBox x:Name="CbDeleteFiles" Content="Delete telemetry &amp; camera files" IsChecked="True"
                      ToolTipService.ToolTip="NvTelemetry64.dll, NvCamera folders, DisplayDriverRAS plugin, and System32\drivers\NVIDIA Corporation are removed. Skipped for components you kept." />
        </StackPanel>

        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <StackPanel Spacing="2">
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="A reboot is recommended after the install." />
            <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="Tweaks ported from NovaOS's “Disable Nvidia Telemetry” — credits to the NovaOS project." />
        </StackPanel>

    </StackPanel>
</ContentDialog>
