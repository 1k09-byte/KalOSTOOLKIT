<Page
    x:Name="RootPage"
    x:Class="KaliteKit.Views.DriverStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KaliteKit.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="DrvRowCard" TargetType="Border" BasedOn="{StaticResource ContentCardStyle}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid>
            <StackPanel Margin="{StaticResource PagePadding}" Spacing="12" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <Button Click="BackButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Driver Store Manager" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock
                        Text="List, export, back up, and clean up third-party driver packages in the Windows DriverStore. Old driver versions are never removed by Windows — cleaning them reclaims disk space. Deletions are protected by a System Restore point."
                        Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- ═══════ Target + actions bar ═══════ -->
                <Border Style="{StaticResource ContentCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F4;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TargetDescription, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="OfflineToggle" Header="" OnContent="Offline image" OffContent="This PC (online)"
                                          IsOn="{x:Bind ViewModel.IsOfflineTarget, Mode=TwoWay}" MinWidth="0" Margin="0,0,12,0" />
                            <TextBox x:Name="OfflineRootBox" PlaceholderText="Path to mounted image root (contains a Windows folder)"
                                     Text="{x:Bind ViewModel.OfflineRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="380" Visibility="{x:Bind ViewModel.IsOfflineTarget, Mode=OneWay}" />
                            <Button Content="Browse…" Click="BrowseOfflineRoot_Click"
                                    Visibility="{x:Bind ViewModel.IsOfflineTarget, Mode=OneWay}" />
                            <Button Content="Confirm offline path" Click="ConfirmOfflineRoot_Click"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsOfflineTarget, Mode=OneWay}" />
                            <ToggleSwitch Header="" OnContent="Show inbox drivers" OffContent="Hide inbox drivers"
                                          IsOn="{x:Bind ViewModel.IncludeInbox, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Add driver (.inf)…" Click="AddDriver_Click" />
                            <Button Content="Smart Cleanup" Click="SmartCleanup_Click" />
                            <Button Content="Export selected…" Click="ExportSelected_Click" />
                            <Button Content="Delete selected" Click="DeleteSelected_Click" />
                            <Button Content="Export all…" Click="ExportAll_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status + progress -->
                <Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource MetricCaptionStyle}"
                                   TextWrapping="Wrap" />
                        <ProgressBar Value="{x:Bind ViewModel.BatchProgress, Mode=OneWay}" Maximum="100"
                                     Visibility="{x:Bind ViewModel.IsBatchCancelable, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    Visibility="{x:Bind ViewModel.IsBatchCancelable, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.BatchProgressText, Mode=OneWay}" Style="{StaticResource MetricCaptionStyle}" />
                            <Button Content="Cancel" Click="CancelBatch_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Native interop failure → fallback offer -->
                <Border Style="{StaticResource ContentCardStyle}"
                        Visibility="{x:Bind ViewModel.NativeInteropFailed, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Native driver-store API unavailable" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="This Windows build does not expose the internal driver-store interface KaliteKit uses for full detail (boot-critical flags, file lists). You can re-run the listing through pnputil — a fully supported Windows component — with fewer detail columns." TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Use pnputil fallback" Click="UseFallback_Click" />
                    </StackPanel>
                </Border>

                <!-- ═══════ Package list ═══════ -->
                <ListView x:Name="PackageList"
                          ItemsSource="{x:Bind ViewModel.Packages, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DriverPackageRow">
                            <Border Style="{StaticResource DrvRowCard}">
                                <Grid ColumnSpacing="12" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.RowSpan="2" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind DriverDisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1"
                                                    Visibility="{x:Bind InUse}">
                                                <TextBlock Text="IN USE" FontSize="11" />
                                            </Border>
                                            <Border Background="#4D8B0000" CornerRadius="4" Padding="6,1"
                                                    Visibility="{x:Bind BootCritical}">
                                                <TextBlock Text="BOOT-CRITICAL" FontSize="11" Foreground="#FFC9C9C9" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind CompanyDisplayName}" Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind SizeText}" HorizontalAlignment="Right" Style="{StaticResource MetricCaptionStyle}" />
                                        <TextBlock Text="{x:Bind DateText}" HorizontalAlignment="Right" Style="{StaticResource MetricCaptionStyle}" />
                                        <TextBlock Text="{x:Bind PublishedName}" HorizontalAlignment="Right" Style="{StaticResource MetricCaptionStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                        <Button Content="Export" Click="ExportOne_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" Tag="{x:Bind}" />
                                        <Button Content="Delete" Click="DeleteOne_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,2" Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyState" Text="No packages matched. Press Refresh to enumerate the store."
                           Visibility="Collapsed" Style="{StaticResource MetricCaptionStyle}" />

                <!-- ═══════ Smart Cleanup review panel ═══════ -->
                <Border x:Name="CleanupPanel" Style="{StaticResource ContentCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            <TextBlock Text="Smart Cleanup — review candidates" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Best-effort detection: candidates are older versions of a driver that no present device is using and that are not boot-critical. Nothing is deleted until you confirm the list below — disconnected devices (docks, printers, USB) may still need these packages."
                                   Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap" />
                        <ListView ItemsSource="{x:Bind ViewModel.CleanupCandidates, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CleanupCandidateRow">
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind InfName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Delete confirmed candidates…" Click="DeleteCleanup_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Close" Click="CloseCleanup_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Busy overlay -->
            <Grid Background="#80000000" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="42" Height="42" />
                    <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
