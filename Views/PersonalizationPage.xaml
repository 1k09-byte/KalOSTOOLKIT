<Page
    x:Name="RootPage"
    x:Class="KalOS.Views.PersonalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:KalOS.Models"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="TintItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid>
            <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource SettingsCardSpacing}" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <TextBlock Text="Personalization" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Pick a section to customize."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard Header="Tint Color"
                                       Description="Add tint to your window to make your experience more personalized.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button x:Name="CustomTintButton" Padding="10,6" Click="CustomTintButton_Click"
                            ToolTipService.ToolTip="Pick a custom tint color">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="18" Height="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Row="0" Grid.Column="0" Fill="White" />
                                <Rectangle Grid.Row="0" Grid.Column="1" Fill="#808080" />
                                <Rectangle Grid.Row="1" Grid.Column="0" Fill="#808080" />
                                <Rectangle Grid.Row="1" Grid.Column="1" Fill="White" />
                            </Grid>
                            <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </controls:SettingsCard>

                <!-- Tint palette: Default + 2 rows of 10 color cards -->
                <GridView ItemsSource="{x:Bind ViewModel.Tints}"
                          SelectedItem="{x:Bind ViewModel.SelectedTint, Mode=TwoWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource TintItemContainerStyle}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="88" ItemHeight="64" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:TintPreset">
                            <StackPanel Spacing="3" Width="84">
                                <Grid Width="80" Height="42">
                                    <Border Width="40" Height="13" CornerRadius="5,5,0,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="{x:Bind Brush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" />
                                    <Border Width="80" Height="36" CornerRadius="6" VerticalAlignment="Bottom"
                                            Background="{x:Bind Brush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" />
                                </Grid>
                                <TextBlock Text="{x:Bind Name}" FontSize="11" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock Text="Windows Customization" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard Header="Visual Effects"
                                       Description="Transparency, animations &amp; performance tuning."
                                       IsClickEnabled="True" Click="VisualEffectsButton_Click" IsActionIconVisible="True">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Windhawk"
                                       Description="Curated desktop and taskbar mods."
                                       IsClickEnabled="True" Click="WindhawkButton_Click" IsActionIconVisible="True">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>