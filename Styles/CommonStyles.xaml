<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:KaliteKit.Services">

    <!-- ═══════════════════════════════════════════════════════════
         Design tokens
         ═══════════════════════════════════════════════════════════ -->

    <!-- Windows 11 Settings app aligns content left with a fixed max width -->
    <x:Double x:Key="PageContentMaxWidth">1000</x:Double>
    
    <!-- Standard spacing for Settings cards -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    <x:Double x:Key="SettingsExpanderCardSpacing">4</x:Double>

    <!-- Unified page layout tokens -->
    <Thickness x:Key="PagePadding">36,28,36,40</Thickness>
    <Thickness x:Key="SectionMargin">0,0,0,24</Thickness>

    <!-- ═══════════════════════════════════════════════════════════
         Converters
         ═══════════════════════════════════════════════════════════ -->
    <services:BoolNegationConverter x:Key="BoolNegationConverter"/>
    <services:BoolNegationConverter x:Key="InverseBoolConverter" />
    <services:InstallButtonLabelConverter x:Key="InstallButtonLabelConverter" />
    <services:BoolToVisibilityConverter x:Key="BoolToVis" />
    <services:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <services:IntToVisibilityConverter x:Key="IntToVis" />
    <services:InverseIntToVisibilityConverter x:Key="InverseIntToVis" />
    <services:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    <services:StringNotEmptyToObjectConverter x:Key="StringNotEmptyToObject" />
    <services:BoolToBrushConverter x:Key="BoolToBrushConverter" TrueBrush="{ThemeResource ErrorBrush}" FalseBrush="{ThemeResource SuccessBrush}" />
    <services:InverseBoolToBrushConverter x:Key="InverseBoolToBrushConverter" TrueBrush="{ThemeResource SuccessBrush}" FalseBrush="{ThemeResource ErrorBrush}" />

    <!-- ═══════════════════════════════════════════════════════════
         Motion
         ═══════════════════════════════════════════════════════════ -->
    <TransitionCollection x:Key="PageNavigationTransition">
        <NavigationThemeTransition>
            <EntranceNavigationTransitionInfo />
        </NavigationThemeTransition>
    </TransitionCollection>

    <TransitionCollection x:Key="StandardEntranceTransitions">
        <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False"/>
    </TransitionCollection>

    <TransitionCollection x:Key="StandardRepositionTransitions">
        <RepositionThemeTransition IsStaggeringEnabled="False"/>
    </TransitionCollection>

    <!-- ═══════════════════════════════════════════════════════════
         List containers 
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

</ResourceDictionary>
