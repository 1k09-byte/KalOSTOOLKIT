<Page
    x:Class="KalOS.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KalOS.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <!-- Grid wrapper works around a known ItemsRepeater/MaxWidth glitch in SettingsExpander -->
        <Grid>
            <StackPanel MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}"
                        Margin="{StaticResource PagePadding}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <!-- Page Header -->
                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <TextBlock Text="Home" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Your post-install companion — drivers, browsers, tweaks, and system tools in one place."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Quick Actions -->
                <TextBlock Text="Quick Actions" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard Header="Device Manager"
                                       Description="Manage hardware devices and drivers.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE964;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button Content="Open" Command="{x:Bind ViewModel.OpenDeviceManagerCommand}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="Windows Settings"
                                       Description="Open the native Windows Settings app.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button Content="Open" Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}" />
                </controls:SettingsCard>

                <!-- Modules -->
                <TextBlock Text="Modules" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard Header="Browsers &amp; Software"
                                       Description="Silent installs via winget, Chocolatey, Scoop, or direct download."
                                       IsClickEnabled="True" Click="NavigateCard_Click" Tag="Browsers">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <controls:SettingsCard Header="GPU Drivers"
                                       Description="Fetch the latest NVIDIA or AMD driver — stripped, silent install."
                                       IsClickEnabled="True" Click="NavigateCard_Click" Tag="GpuDrivers">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Hardware Affinity"
                                       Description="Optimize CPU affinity and MSI mode for latency-sensitive devices."
                                       IsClickEnabled="True" Click="NavigateCard_Click" Tag="AffinityManager">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9F3;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Customize Windows"
                                       Description="Visual effects, transparency, and performance tuning."
                                       IsClickEnabled="True" Click="NavigateCard_Click" Tag="Personalization">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!-- Community -->
                <TextBlock Text="Community" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard Header="KalOS Discord"
                                       Description="Ask for support and make friends!">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A7;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                    <HyperlinkButton Content="Join server" Click="JoinDiscord_Click" />
                </controls:SettingsCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>