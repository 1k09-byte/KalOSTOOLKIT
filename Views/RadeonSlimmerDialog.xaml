<ContentDialog
    x:Class="KalOS.Views.RadeonSlimmerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KalOS.Models"
    mc:Ignorable="d"
    Title="Radeon Software Slimmer — Package Customizer"
    PrimaryButtonText="Install Custom Package"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    MinWidth="1100"
    MaxWidth="1180"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">1100</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1180</x:Double>
    </ContentDialog.Resources>

    <Grid Width="1060" MaxHeight="680" Margin="0,2,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Subtitle -->
        <TextBlock Grid.Row="0"
                   Text="Select the modules, scheduled tasks, and INF driver components to keep. Unchecked items will be stripped prior to installation."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,10" />

        <!-- 2. Horizontal Preset Selection Strip -->
        <Border Grid.Row="1"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Preset:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <RadioButton Content="Gaming (Recommended)" x:Name="RbGaming" IsChecked="True" Checked="Preset_Checked" Tag="Gaming" FontSize="12" />
                    <RadioButton Content="Minimal (Display Only)" x:Name="RbDisplayOnly" Checked="Preset_Checked" Tag="DisplayOnly" FontSize="12" />
                    <RadioButton Content="Full Experience (No Telemetry)" x:Name="RbFull" Checked="Preset_Checked" Tag="Full" FontSize="12" />
                    <RadioButton Content="Custom" x:Name="RbCustom" Checked="Preset_Checked" Tag="Custom" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Pre-Install 3 Tabs -->
        <Pivot Grid.Row="2" Margin="0,-6,0,0">
            <!-- 1. Packages Tab -->
            <PivotItem Header="Packages">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Action Bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <Button Content="+ Select All" Click="SelectAllPackages_Click" FontSize="11" Padding="8,3" />
                        <Button Content="- Deselect All" Click="SelectNonePackages_Click" FontSize="11" Padding="8,3" />
                    </StackPanel>

                    <!-- Table Header -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="8,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KEEP" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="PRODUCT NAME" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="LOCATION / URL" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="TYPE" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="DESCRIPTION" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- Table Content -->
                    <ScrollViewer Grid.Row="2" MaxHeight="450"
                                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                  BorderThickness="1" CornerRadius="0,0,4,4">
                        <ItemsControl ItemsSource="{x:Bind Packages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RadeonPackageItem">
                                    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Padding="8,5">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind IsRemovable}" MinWidth="0" VerticalAlignment="Center" Margin="2,0,0,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ProductName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind RelativePath}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{x:Bind LocationUrl}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <Border Grid.Column="3" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind PackageType}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="4" Text="{x:Bind Description}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- 2. Scheduled Tasks Tab -->
            <PivotItem Header="Scheduled Tasks">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Action Bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <Button Content="+ Enable All" Click="EnableAllTasks_Click" FontSize="11" Padding="8,3" />
                        <Button Content="- Disable All" Click="DisableAllTasks_Click" FontSize="11" Padding="8,3" />
                    </StackPanel>

                    <!-- Table Header -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="8,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ENABLED" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="TASK URI" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="COMMAND" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="DESCRIPTION" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- Table Content -->
                    <ScrollViewer Grid.Row="2" MaxHeight="450"
                                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                  BorderThickness="1" CornerRadius="0,0,4,4">
                        <ItemsControl ItemsSource="{x:Bind ScheduledTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RadeonScheduledTaskItem">
                                    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Padding="8,5">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="320" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" Margin="2,0,0,0" />

                                            <TextBlock Grid.Column="1" Text="{x:Bind Uri}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="2" Text="{x:Bind Command}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="3" Text="{x:Bind Description}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- 3. Display Driver Components Tab -->
            <PivotItem Header="Display Driver Components">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Action Bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <Button Content="+ Select All" Click="SelectAllDisplay_Click" FontSize="11" Padding="8,3" />
                        <Button Content="- Deselect All" Click="SelectNoneDisplay_Click" FontSize="11" Padding="8,3" />
                    </StackPanel>

                    <!-- Table Header -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="8,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KEEP" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="DIRECTORY" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="INF FILE" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="DESCRIPTION" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- Table Content -->
                    <ScrollViewer Grid.Row="2" MaxHeight="450"
                                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                  BorderThickness="1" CornerRadius="0,0,4,4">
                        <ItemsControl ItemsSource="{x:Bind DisplayComponents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RadeonDisplayComponentItem">
                                    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Padding="8,5">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind IsRemovable}" MinWidth="0"
                                                      VerticalAlignment="Center" Margin="2,0,0,0" />

                                            <TextBlock Grid.Column="1" Text="{x:Bind Directory}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="2" Text="{x:Bind InfFile}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="3" Text="{x:Bind Description}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</ContentDialog>