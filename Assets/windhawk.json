{
  "format": "windhawk-user-data-v1",
  "appSettings": {
    "language": "en",
    "theme": "dark",
    "disableUpdateCheck": false,
    "devModeOptOut": false,
    "hideTrayIcon": false,
    "alwaysCompileModsLocally": false,
    "dontAutoShowToolkit": false,
    "modTasksDialogDelay": 2000,
    "loggingVerbosity": 0,
    "engine": {
      "loggingVerbosity": 0,
      "include": [],
      "exclude": [],
      "injectIntoCriticalProcesses": false,
      "injectIntoIncompatiblePrograms": false,
      "injectIntoGames": false
    }
  },
  "mods": [
    {
      "modId": "explorer-context-menu-classic",
      "version": "1.0.2",
      "name": "Classic context menu on Windows 11",
      "settings": {
        "overrideWithCtrl": 1
      }
    },
    {
      "modId": "start-menu-size",
      "version": "1.1",
      "name": "Start Menu Size",
      "settings": {
        "width": 620,
        "height": 620,
        "searchWidth": 780,
        "searchHeight": 0
      }
    },
    {
      "modId": "taskbar-dock-animation",
      "version": "1.9.2",
      "name": "Taskbar Dock Animation",
      "settings": {
        "AnimationType": 0,
        "MaxScale": 130,
        "EffectRadius": 100,
        "SpacingFactor": 50,
        "BounceDelay": 500,
        "FocusDuration": 150,
        "MirrorForTopTaskbar": 0,
        "DisableVerticalBounce": 0,
        "TaskbarLabelsMode": 0,
        "ExcludeSystemButtonsMode": 0,
        "LerpSpeed": 60,
        "DisableBounce": 0
      }
    },
    {
      "modId": "translucent-windows",
      "version": "1.8.0",
      "name": "Translucent Windows",
      "settings": {
        "RenderingMod.ThemeBackground": 1,
        "RenderingMod.SysColors": 0,
        "RenderingMod.AccentColorControls": 1,
        "BackgroundEffects.type": "acrylicblur",
        "BackgroundEffects.AccentBlurBehind": "3A232323",
        "FlyoutsEffects": 1,
        "RuledPrograms[0].target": "mspaint.exe",
        "RuledPrograms[0].RenderingMod.ThemeBackground": 0,
        "RuledPrograms[0].RenderingMod.AccentColorControls": 0,
        "RuledPrograms[0].BackgroundEffects.type": "none",
        "RuledPrograms[0].BackgroundEffects.AccentBlurBehind": "3A232323"
      }
    },
    {
