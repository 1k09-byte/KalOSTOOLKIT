<Page
    x:Class="KalOS.Views.ProcessControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KalOS.ViewModels"
    xmlns:models="using:KalOS.Models.ProcessControl"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Flyout x:Name="RuleEditorFlyout" Placement="Right">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="MaxWidth" Value="760" />
                    <Setter Property="MinWidth" Value="720" />
                    <Setter Property="MaxHeight" Value="680" />
                    <Setter Property="Padding" Value="16" />
                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <StackPanel Spacing="10" Margin="0,0,12,0">
                    <TextBlock Text="Rule" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="A rule automatically applies the settings below to every copy of the process you choose — now and every time it launches."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    <TextBox Header="Rule name" Text="{x:Bind ViewModel.EditingRule.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Optional display name (defaults to the process name)" />
                    <TextBox Header="Process to control" Text="{x:Bind ViewModel.EditingRule.ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="e.g. game.exe — the process this rule applies to" />
                    <ComboBox x:Name="MatchModeBox" Header="How to match it" SelectionChanged="Editor_Changed"
                              ToolTipService.ToolTip="Process name matches every copy; full path distinguishes same-named apps; command line matches a launch argument (e.g. --render-worker)." />
                    <CheckBox Content="Rule enabled" IsChecked="{x:Bind ViewModel.EditingRule.Enabled, Mode=TwoWay}"
                              ToolTipService.ToolTip="Uncheck to keep the rule saved but inactive (nothing is applied)" />

                    <TextBlock Text="Instance targeting — which copy of the process" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="InstanceIndexBox" Header="Instance number (leave blank = every copy)"
                             PlaceholderText="blank = all copies; 2 = only the 2nd copy"
                             ToolTipService.ToolTip="Windows counts copies in launch order. Leave blank to control every instance." />

                    <TextBlock Text="Scheduling — how much CPU, disk and memory bandwidth it gets" FontSize="12" Opacity="0.7" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CpuPriorityBox" Grid.Column="0" Header="CPU priority"
                                  ToolTipService.ToolTip="How urgently Windows schedules this process. Higher = snappier, lower = polite to everything else. Leave on (keep) to not touch it."
                                  SelectionChanged="Editor_Changed" />
                        <ComboBox x:Name="IoPriorityBox" Grid.Column="1" Header="I/O priority"
                                  ToolTipService.ToolTip="How urgently it gets disk/network access. Very Low makes big background reads yield to everything else."
                                  SelectionChanged="Editor_Changed" />
                        <ComboBox x:Name="MemoryPriorityBox" Grid.Column="2" Header="Memory priority"
                                  ToolTipService.ToolTip="Low values make its memory pages the first evicted when RAM runs low (i.e. deprioritize its cache)."
                                  SelectionChanged="Editor_Changed" />
                    </Grid>

                    <TextBlock Text="Core pinning — which CPU cores it may use" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="Presets choose cores for you; unavailable ones are disabled for your CPU."
                               Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="E/P = efficiency/performance cores; CCD = AMD chiplet; SMT = second thread per core.">
                        <Button Content="E-Cores Off" Tag="ECoresOff" Click="RulePreset_Click"
                                ToolTipService.ToolTip="Run only on performance cores (hides efficiency cores)" />
                        <Button Content="P-Cores Off" Tag="PCoresOff" Click="RulePreset_Click"
                                ToolTipService.ToolTip="Run only on efficiency cores (cooler, slower — good for background tasks)" />
                        <Button Content="CCD0 Off" Tag="Ccd0Off" Click="RulePreset_Click"
                                ToolTipService.ToolTip="Keep the process off the first CPU chiplet" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="CCD1 Off" Tag="Ccd1Off" Click="RulePreset_Click"
                                ToolTipService.ToolTip="Keep the process off the second CPU chiplet" />
                        <Button Content="SMT Off" Tag="SmtOff" Click="RulePreset_Click"
                                ToolTipService.ToolTip="One thread per physical core — often better for games" />
                        <Button Content="Clear pin" Click="ClearPin_Click"
                                ToolTipService.ToolTip="Let the process use any core again" />
                    </StackPanel>
                    <TextBlock Text="Or pick the exact cores and threads it may run on:" FontSize="12" Opacity="0.7" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Select all" Click="CoreSelectAll_Click"
                                ToolTipService.ToolTip="Allow every core and thread" />
                        <Button Content="Clear" Click="CoreClearAll_Click"
                                ToolTipService.ToolTip="Deselect all (rule runs on any core)" />
                        <TextBlock x:Name="CoreSelectionText" VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="150" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CorePickerPanel" Orientation="Horizontal" Spacing="14" />
                    </ScrollViewer>
                    <TextBlock Text="P = performance core, E = efficiency core (hybrid CPUs). A selected set pins the rule; 'Dynamic core cap' then operates within that selection."
                               Opacity="0.6" FontSize="11" TextWrapping="Wrap" />

                    <TextBlock Text="Limits — hard ceilings on CPU and copies" FontSize="12" Opacity="0.7" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="MaxCoresBox" Grid.Column="0" Header="Core cap (0 = no cap)" Minimum="0" Maximum="128"
                                   ToolTipService.ToolTip="Never let it use more than this many CPU cores. Operates within the selected cores when a pin is set, else system-wide. Needs 'Dynamic core cap' checked below."
                                   Value="{x:Bind ViewModel.EditingRule.MaxCores, Mode=TwoWay}" />
                        <NumberBox x:Name="MaxCpuBox" Grid.Column="1" Header="CPU % ceiling (0 = off)" Minimum="0" Maximum="100"
                                   ToolTipService.ToolTip="Never let it average more than this percent of total CPU. Needs 'Dynamic core cap' checked below."
                                   Value="{x:Bind ViewModel.EditingRule.MaxCpuPercent, Mode=TwoWay}" />
                        <TextBox x:Name="MaxInstancesBox" Grid.Column="2" Header="Max copies" PlaceholderText="unlimited"
                                 ToolTipService.ToolTip="Extra copies beyond this are terminated automatically. Leave blank for unlimited." />
                    </Grid>
                    <TextBlock Text="Note: core/CPU limits apply within the picked cores when a pin is set, otherwise system-wide — and only when 'Dynamic core cap' below is checked."
                               Opacity="0.6" FontSize="11" TextWrapping="Wrap" />

                    <TextBlock Text="Behavior" FontSize="12" Opacity="0.7" />
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="0" Content="Dynamic core cap" IsChecked="{x:Bind ViewModel.EditingRule.EnableCoreCap, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Shrink its usable cores when it idles; grow them back under load (uses the Max cores / CPU % limits above)" />
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="Hard throttle (suspend duty cycle)" IsChecked="{x:Bind ViewModel.EditingRule.HardThrottle, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Briefly suspend its threads when it blows past the CPU % ceiling — a hard guarantee, not a request" />
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="Spread instances across cores" IsChecked="{x:Bind ViewModel.EditingRule.SpreadInstances, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Give each copy a different set of physical cores so they don't fight" />
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Blocklist (terminate on sight)" IsChecked="{x:Bind ViewModel.EditingRule.Blocklist, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Kill this process the moment it appears — for unwanted background launchers" />
                        <CheckBox Grid.Row="2" Grid.Column="0" Content="AutoRevive (relaunch on exit)" IsChecked="{x:Bind ViewModel.EditingRule.Revive, Mode=TwoWay}"
                                  ToolTipService.ToolTip="If it closes unexpectedly, start it again automatically" />
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="Keep Running (protected)" IsChecked="{x:Bind ViewModel.EditingRule.KeepRunning, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Like AutoRevive, but also blocks closing it from here (use Allow Close to override once)" />
                        <CheckBox Grid.Row="3" Grid.Column="0" Content="Prevent sleep while running" IsChecked="{x:Bind ViewModel.EditingRule.PreventSleep, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Windows won't sleep while any copy of this process runs (downloads, renders…)" />
                    </Grid>

                    <TextBlock Text="Saving applies the change immediately to running copies of the process — no restart needed. Use Restart on the Processes tab for a completely fresh instance."
                               Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Click="CancelRuleEdit_Click" />
                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveRule_Click"
                                ToolTipService.ToolTip="Persist the rule and push it to running processes now" />
                    </StackPanel>
                </StackPanel>
        </Flyout>
    </Page.Resources>

    <Grid Padding="24,16,24,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Process Control" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Set rules per process — priority, cores, limits — applied live, to new launches, and at login."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" Header="Engine" IsOn="{x:Bind ViewModel.EngineEnabled, Mode=TwoWay}"
                          Toggled="EngineToggle_Toggled" MinWidth="110" />
            <ToggleSwitch Grid.Column="2" Header="Boost Mode" IsOn="{x:Bind ViewModel.BoostActive, Mode=TwoWay}"
                          Toggled="BoostToggle_Toggled" MinWidth="120"
                          ToolTipService.ToolTip="Gives every CPU core a small always-on speed boost: disables core parking (idle cores wake instantly instead of taking a moment to spin up) and forces the max processor frequency. Uses a little more idle power; turning it off restores your previous power settings exactly." />
            <ToggleSwitch Grid.Column="3" Header="Run in background" IsOn="{x:Bind ViewModel.RunInBackground, Mode=TwoWay}"
                          Toggled="RunInBackground_Toggled" MinWidth="140"
                          ToolTipService.ToolTip="When ON, pressing X hides KalOS to the system tray instead of closing it — rules keep applying and you restore it by double-clicking the tray icon. When OFF, X exits the app normally." />
            <Button Grid.Column="4" Content="Restore all managed" VerticalAlignment="Center" Click="RestoreAll_Click"
                    ToolTipService.ToolTip="Undo every rule on every running process — one-click safety net" />
        </Grid>

        <!-- ── Topology strip ── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18">
            <TextBlock FontSize="12" Opacity="0.8">
                <Run Text="CPU: " /><Run Text="{x:Bind ViewModel.CpuName}" />
            </TextBlock>
            <TextBlock FontSize="12" Opacity="0.8">
                <Run Text="Logical: " /><Run Text="{x:Bind ViewModel.LogicalCount}" />
            </TextBlock>
            <TextBlock FontSize="12" Opacity="0.8">
                <Run Text="Physical: " /><Run Text="{x:Bind ViewModel.PhysicalCount}" />
            </TextBlock>
            <TextBlock FontSize="12" Opacity="0.8" Text="{x:Bind ViewModel.CcdEstimatedLabel}" />
        </StackPanel>

        <!-- ── Main content ── -->
        <Pivot Grid.Row="2">
            <!-- ═══ Processes ═══ -->
            <PivotItem Header="Processes">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="SearchBox" PlaceholderText="Search processes…" Width="220"
                                 ToolTipService.ToolTip="Filter the list by process name"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Kill" Click="Kill_Click"
                                ToolTipService.ToolTip="Terminate the selected process (asks first for system-critical ones)" />
                        <Button Content="Restart" Click="Restart_Click"
                                ToolTipService.ToolTip="Close the selected process and relaunch it, so edited rules start from a clean instance" />
                        <Button Content="Restore" Click="Restore_Click"
                                ToolTipService.ToolTip="Undo everything rules applied to the selected process — back to Windows defaults" />
                        <Button Content="Allow Close" Click="AllowClose_Click"
                                ToolTipService.ToolTip="Override a Keep Running rule for this process (10 minutes)" />
                        <Button Content="Apply rule…">
                            <Button.Flyout>
                                <MenuFlyout x:Name="ApplyRuleFlyout" Opening="ApplyRuleFlyout_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button Content="Presets…">
                            <Button.Flyout>
                                <MenuFlyout x:Name="PresetFlyout" Opening="PresetFlyout_Opening" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <ListView x:Name="ProcessList" Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Processes}"
                              SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}"
                              RightTapped="ProcessList_RightTapped"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="34" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessItem">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Pid}" Opacity="0.55" FontSize="11" />
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="6,1" Visibility="{x:Bind ManagedVisibility}">
                                            <TextBlock Text="{x:Bind ManagedBy}" FontSize="10" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind CpuPercentText}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind MemText}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind PriorityText}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind AffinityText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ContextFlyout>
                            <MenuFlyout Opening="ProcessMenu_Opening">
                                <MenuFlyoutItem Text="Kill" Click="Kill_Click" />
                                <MenuFlyoutItem Text="Restart (relaunch with rules applied)" Click="Restart_Click" />
                                <MenuFlyoutItem Text="Restore to defaults" Click="Restore_Click" />
                                <MenuFlyoutItem Text="Allow Close (override Keep Running)" Click="AllowClose_Click" />
                                <MenuFlyoutItem Text="Create rule for this process" Click="CreateRuleForProcess_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="CtxApplyRule" Text="Apply rule" />
                                <MenuFlyoutSubItem x:Name="CtxPresets" Text="Core Isolation preset" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- ═══ Rules ═══ -->
            <PivotItem Header="Rules">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="New rule" Click="NewRule_Click"
                                ToolTipService.ToolTip="Create a rule for a process" />
                        <Button Content="Edit" Click="EditRule_Click"
                                ToolTipService.ToolTip="Edit the selected rule (changes apply to running processes instantly)" />
                        <Button Content="Delete" Click="DeleteRule_Click"
                                ToolTipService.ToolTip="Remove the rule and restore its processes to Windows defaults" />
                        <Button Content="Export" Click="ExportRules_Click"
                                ToolTipService.ToolTip="Save all rules and profiles to a JSON file" />
                        <Button Content="Import" Click="ImportRules_Click"
                                ToolTipService.ToolTip="Load rules and profiles from a JSON file" />
                        <TextBlock Text="Saving a rule applies it instantly to running processes; it also re-applies to every future launch."
                                   Opacity="0.6" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <ListView x:Name="RulesList" Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Rules}"
                              SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}"
                              DoubleTapped="RulesList_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProcessRule">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind MatchTarget}" Opacity="0.7" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Summary}" Opacity="0.7" FontSize="12" />
                                    <CheckBox Grid.Column="3" IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                              Checked="RuleEnabledChanged" Unchecked="RuleEnabledChanged"
                                              ToolTipService.ToolTip="Rule enabled" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- ═══ Engine ═══ -->
            <PivotItem Header="Engine">
                <ScrollViewer>
                    <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="AutoBalance" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Watches everything running in the background. When one process hogges the CPU for a while, its priority is gently lowered so your foreground apps stay responsive — and it's restored automatically once the load drops. Nothing is ever killed."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <ToggleSwitch Header="Enabled" IsOn="{x:Bind ViewModel.AutoBalanceEnabled, Mode=TwoWay}" />
                        <Grid ColumnSpacing="8" Width="520">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="CPU % threshold" ToolTipService.ToolTip="Only processes using more CPU than this get rebalanced." />
                                <NumberBox Value="{x:Bind ViewModel.AutoBalanceThreshold, Mode=TwoWay}" Minimum="10" Maximum="99" SmallChange="5" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Sustain (s)" ToolTipService.ToolTip="How long it must hog CPU above the threshold before we act — avoids false alarms from short bursts." />
                                <NumberBox Value="{x:Bind ViewModel.AutoBalanceSustain, Mode=TwoWay}" Minimum="3" Maximum="300" SmallChange="5" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Recover (s)" ToolTipService.ToolTip="After its load drops, wait this long before restoring its original priority." />
                                <NumberBox Value="{x:Bind ViewModel.AutoBalanceRecover, Mode=TwoWay}" Minimum="5" Maximum="600" SmallChange="5" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Never rebalance these (comma-separated process names)" Opacity="0.8" FontSize="12" />
                        <TextBox Text="{x:Bind ViewModel.AutoBalanceExclusions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="520"
                                 PlaceholderText="e.g. game.exe, obs64.exe"
                                 ToolTipService.ToolTip="Processes listed here are never deprioritized by AutoBalance — use it for apps where any hiccup matters (games, streaming)." />

                        <TextBlock Text="Foreground Boost" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,10,0,0" />
                        <TextBlock Text="Gives the app you're actively using a small priority bump (Above Normal) so the frontmost window always feels snappy, and drops it back when you switch away."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <ToggleSwitch Header="Enabled" IsOn="{x:Bind ViewModel.ForegroundBoostEnabled, Mode=TwoWay}" />

                        <Button Content="Save engine settings" Click="SaveEngine_Click" HorizontalAlignment="Left" Margin="0,6,0,0" />

                        <TextBlock Text="Background enforcement" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                        <TextBlock Text="{x:Bind ViewModel.RulesAutostartText}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <Button Content="Register / repair login autostart" Click="RepairAutostart_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ═══ Monitor ═══ -->
            <PivotItem Header="Monitor">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="24">
                        <TextBlock FontSize="14"><Run Text="CPU " /><Run Text="{x:Bind ViewModel.TotalCpuText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock FontSize="14"><Run Text="Memory " /><Run Text="{x:Bind ViewModel.MemText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock FontSize="14"><Run Text="Disk " /><Run Text="{x:Bind ViewModel.DiskText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Per-core load (live)" FontSize="12" Opacity="0.7" />
                    <Grid Grid.Row="2">
                        <Canvas x:Name="CoreScaleCanvas" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Canvas x:Name="CoreCanvas" Height="110" />
                        </ScrollViewer>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Total CPU history (90s)" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                    <Grid Grid.Row="4">
                        <Canvas x:Name="HistoryScaleCanvas" />
                        <Canvas x:Name="HistoryCanvas" Height="80" Width="720" />
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- ═══ Action log ═══ -->
            <PivotItem Header="Action Log">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Export log" Click="ExportActions_Click" />
                        <TextBlock Text="Every automatic rule action is recorded here and in the app log."
                                   Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Actions}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ActionLogEntry">
                                <TextBlock Text="{x:Bind Display}" FontFamily="Consolas" FontSize="12" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- ── Status bar ── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
            <TextBlock Text="{x:Bind ViewModel.StatusText}" Opacity="0.7" FontSize="12" />
            <TextBlock Text="{x:Bind ViewModel.ManagedCountText, Mode=OneWay}" Opacity="0.55" FontSize="12" />
        </StackPanel>
    </Grid>
</Page>