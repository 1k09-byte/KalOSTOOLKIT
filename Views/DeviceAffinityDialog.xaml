<ContentDialog
    x:Class="KalOS.Views.DeviceAffinityDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KalOS.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:sys="using:System"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.DeviceName, Mode=OneWay}"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    PrimaryButtonClick="SaveClick"
    DefaultButton="Primary">

    <Grid MaxWidth="720" MinWidth="600" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Header Info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{x:Bind ViewModel.DeviceCategory, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.DeviceId, Mode=OneWay}" 
                       Style="{StaticResource CaptionTextBlockStyle}" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,0,12,0">
                
                <!-- MSI Configuration Section -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Message Signaled Interrupts (MSI)" FontWeight="SemiBold" FontSize="14" />
                        
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="MSI Interrupt Mode" FontWeight="Medium" FontSize="13" />
                                <CheckBox Content="Enable MSI Mode" IsChecked="{x:Bind ViewModel.MsiEnabled, Mode=TwoWay}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="MSI Message Limit" FontWeight="Medium" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.MaxMsiLimitText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <NumberBox Value="{x:Bind ViewModel.MsiLimit, Mode=TwoWay}" 
                                           IsEnabled="{x:Bind ViewModel.IsMsiLimitEnabled, Mode=OneWay}"
                                           Minimum="1" 
                                           Maximum="{x:Bind ViewModel.MaxMsiLimit}" 
                                           SpinButtonPlacementMode="Inline" 
                                           HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.MsiLimitDescription, Mode=OneWay}" 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Interrupt Policy Section -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Interrupt Priority &amp; Policy" FontWeight="SemiBold" FontSize="14" />
                        
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Device Priority" FontWeight="Medium" FontSize="13" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.Priorities}" 
                                          SelectedItem="{x:Bind ViewModel.DevicePriority, Mode=TwoWay}" 
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Device Policy" FontWeight="Medium" FontSize="13" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.Policies}" 
                                          SelectedItem="{x:Bind ViewModel.DevicePolicy, Mode=TwoWay}" 
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.PolicyDescription, Mode=OneWay}" 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Processor Affinity Section -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="CPU Affinity Scheduling Mask" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Assign interrupts to specific physical cores or SMT threads." 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            
                            <!-- Quick Selection Toolbar -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Content="All" Click="SelectAll_Click" IsEnabled="{x:Bind ViewModel.IsCoreSelectionEnabled, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="Select all CPU cores" />
                                <Button Content="None" Click="ClearAll_Click" IsEnabled="{x:Bind ViewModel.IsCoreSelectionEnabled, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="Deselect all CPU cores" />
                                <Button Content="P-Cores" Click="SelectPCores_Click" IsEnabled="{x:Bind ViewModel.IsCoreSelectionEnabled, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="Select only Performance Cores" />
                                <Button Content="E-Cores" Click="SelectECores_Click" IsEnabled="{x:Bind ViewModel.IsCoreSelectionEnabled, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="Select only Efficiency Cores" />
                            </StackPanel>
                        </Grid>

                        <!-- Core Groups -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" IsEnabled="{x:Bind ViewModel.IsCoreSelectionEnabled, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:CpuCoreGroup">
                                    <StackPanel Margin="0,8,0,12" Spacing="8">
                                        <!-- Group Header -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        
                                        <!-- Cores Grid -->
                                        <GridView ItemsSource="{x:Bind Cores}" SelectionMode="None">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:CpuCoreInfo">
                                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                                            BorderThickness="1" CornerRadius="6" 
                                                            Margin="0,0,8,8" Width="130" Padding="8">
                                                        <StackPanel Spacing="6">
                                                            <Grid>
                                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Left" />
                                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{x:Bind CoreTypeLabel}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{x:Bind Threads}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="viewmodels:CpuThreadInfo">
                                                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,0,0,2">
                                                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="11" />
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mask Summary Footer -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Selected Threads:" FontWeight="Medium" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedThreadsSummary, Mode=OneWay}" 
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                               FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CalculatedMaskHex, Mode=OneWay}" 
                                           FontFamily="Consolas, Cascadia Code, monospace" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           FontSize="12" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>

