<Page
    x:Name="RootPage"
    x:Class="KalOS.Views.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KalOS.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="BrowserItemTemplate" x:DataType="viewmodels:InstallableItem">
            <StackPanel Margin="0,0,0,4">
                <controls:SettingsCard Header="{x:Bind Name}">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="{x:Bind IconPath, FallbackValue=''}" Width="24" Height="24" />
                    </controls:SettingsCard.HeaderIcon>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="UninstallButton_Click"
                                Tag="{Binding}"
                                IsEnabled="{x:Bind IsInstallEnabled, Mode=OneWay}"
                                Visibility="{x:Bind IsUninstallVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Uninstall" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="InstallButton_Click"
                                Tag="{Binding}"
                                Visibility="{x:Bind IsInstallVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{x:Bind IsInstallEnabled, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}">
                            <Button.Content>
                                <Grid Height="20" MinWidth="60">
                                    <TextBlock Text="Install" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{x:Bind IsInstalling, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"/>
                                    <ProgressRing IsActive="{x:Bind IsInstalling, Mode=OneWay}"
                                                  Visibility="{x:Bind IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                  Width="16" Height="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button.Content>
                        </Button>

                        <Button Click="DirectInstallButton_Click"
                                Tag="{Binding}"
                                Visibility="{x:Bind IsDirectInstallVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{x:Bind IsInstallEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Install directly" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="CancelInstallButton_Click"
                                Tag="{Binding}"
                                Visibility="{x:Bind IsCancelVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Description + Extensions — fills the previously empty left space -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,2,0,0"
                        Visibility="{Binding HasExtensions, FallbackValue=False, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind Description}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="4" MinWidth="200">
                            <TextBlock Text="Browser Extensions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{Binding Extensions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ExtensionItem">
                                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status Feedback -->
                <InfoBar IsOpen="{x:Bind ShowSuccessNotice, Mode=TwoWay}" Severity="Success" Message="{x:Bind StatusText, Mode=OneWay}" IsClosable="True" Margin="0,4,0,0" />
                <InfoBar IsOpen="{x:Bind IsError, Mode=TwoWay}" Severity="Error" Message="{x:Bind StatusText, Mode=OneWay}" IsClosable="True" Margin="0,4,0,0" />
                <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Margin="0,4,0,0" Visibility="{x:Bind ShowProgress, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- External software: same card/buttons, but no browser-extensions panel -->
        <DataTemplate x:Key="SoftwareItemTemplate" x:DataType="viewmodels:SoftwareItem">
            <StackPanel Margin="0,0,0,4">
                <controls:SettingsCard Header="{x:Bind Name}"
                                       Description="{x:Bind Description}">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="{x:Bind IconPath, FallbackValue=''}" Width="24" Height="24" />
                    </controls:SettingsCard.HeaderIcon>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="UninstallButton_Click"
                                Tag="{Binding}"
                                IsEnabled="{x:Bind IsInstallEnabled, Mode=OneWay}"
                                Visibility="{x:Bind IsUninstallVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Uninstall" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="InstallButton_Click"
                                Tag="{Binding}"
                                Visibility="{x:Bind IsInstallVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{x:Bind IsInstallEnabled, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}">
                            <Button.Content>
                                <Grid Height="20" MinWidth="60">
                                    <TextBlock Text="Install" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{x:Bind IsInstalling, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"/>
                                    <ProgressRing IsActive="{x:Bind IsInstalling, Mode=OneWay}"
                                                  Visibility="{x:Bind IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                  Width="16" Height="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button.Content>
                        </Button>

                        <Button Click="DirectInstallButton_Click"
                                Tag="{Binding}"
                                Visibility="{x:Bind IsDirectInstallVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{x:Bind IsInstallEnabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Install directly" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="CancelInstallButton_Click"
                                Tag="{Binding}"
                                Visibility="{x:Bind IsCancelVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Status Feedback -->
                <InfoBar IsOpen="{x:Bind ShowSuccessNotice, Mode=TwoWay}" Severity="Success" Message="{x:Bind StatusText, Mode=OneWay}" IsClosable="True" Margin="0,4,0,0" />
                <InfoBar IsOpen="{x:Bind IsError, Mode=TwoWay}" Severity="Error" Message="{x:Bind StatusText, Mode=OneWay}" IsClosable="True" Margin="0,4,0,0" />
                <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Margin="0,4,0,0" Visibility="{x:Bind ShowProgress, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid>
            <StackPanel MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch"
                        Margin="{StaticResource PagePadding}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <TextBlock Text="Browsers &amp; Software" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Select a web browser or software to install silently." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12"
                            Visibility="{x:Bind ViewModel.IsWingetAvailable, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <InfoBar IsOpen="True"
                             Severity="Warning"
                             Title="Package manager unavailable"
                             Message="{x:Bind ViewModel.ScanStatusText, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Content="Repair winget"
                                    Command="{x:Bind ViewModel.RepairWingetCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRepairingWinget, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsRepairingWinget, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                 Margin="0,8,0,0" />
                </StackPanel>

                <SelectorBar x:Name="CategorySelector"
                             SelectionChanged="CategorySelector_SelectionChanged"
                             Margin="0,4,0,16">
                    <SelectorBarItem x:Name="BrowsersSelectorItem" Text="Web Browsers" />
                    <SelectorBarItem x:Name="SoftwareSelectorItem" Text="External Software" />
                </SelectorBar>

                    <!-- Browsers Section -->
                    <StackPanel x:Name="BrowsersSection" Visibility="Visible">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Browsers}" 
                                      ItemTemplate="{StaticResource BrowserItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Software Section -->
                    <StackPanel x:Name="SoftwareSection" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Software}" 
                                      ItemTemplate="{StaticResource SoftwareItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
