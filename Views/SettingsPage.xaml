<Page
    x:Class="KalOS.Views.SettingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KalOS.ViewModels"
    xmlns:models="using:KalOS.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="TintItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid>
            <StackPanel MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}"
                        Margin="{StaticResource PagePadding}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Customize the app's appearance, window backdrop, and license information."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <TextBlock Text="Personalization" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="App theme" FontWeight="SemiBold" />
                            <TextBlock Text="Choose between the light and dark appearance."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.Themes}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                  MinWidth="150" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B1;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Backdrop material" FontWeight="SemiBold" />
                            <TextBlock Text="Mica or Acrylic rendered behind the app window."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.Backdrops}"
                                  SelectedItem="{x:Bind ViewModel.SelectedBackdrop, Mode=TwoWay}"
                                  MinWidth="150" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18"
                                  Foreground="{ThemeResource AccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Tint Color" FontWeight="SemiBold" />
                            <TextBlock Text="Add tint to your window to make your experience more personalized."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="SettingsCustomTintButton" Padding="10,6"
                                Click="CustomTintButton_Click" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Pick a custom tint color">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid Width="18" Height="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="White" />
                                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#808080" />
                                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#808080" />
                                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="White" />
                                </Grid>
                                <FontIcon Glyph="&#xE70D;" FontSize="10"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tint palette: Default + 2 rows of 10 color cards -->
                <GridView ItemsSource="{x:Bind TintViewModel.Tints}"
                          SelectedItem="{x:Bind TintViewModel.SelectedTint, Mode=TwoWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource TintItemContainerStyle}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="88" ItemHeight="64" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:TintPreset">
                            <StackPanel Spacing="3" Width="84">
                                <Grid Width="80" Height="42">
                                    <Border Width="40" Height="13" CornerRadius="5,5,0,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="{x:Bind Brush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" />
                                    <Border Width="80" Height="36" CornerRadius="6" VerticalAlignment="Bottom"
                                            Background="{x:Bind Brush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" />
                                </Grid>
                                <TextBlock Text="{x:Bind Name}" FontSize="11" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock Text="System backdrop materials look best with Transparency effects enabled in Windows Settings (Personalization &gt; Colors)."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Margin="1,8,0,0" />

                <TextBlock Text="Background Image" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="Background image" FontWeight="SemiBold" />
                            <TextBlock Text="Set a custom background image for the app window."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BackgroundImagePath, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{x:Bind ViewModel.HasBackgroundImage, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Browse" Command="{x:Bind ViewModel.BrowseImageCommand}" />
                            <Button Content="Clear" Command="{x:Bind ViewModel.ClearImageCommand}"
                                    Visibility="{x:Bind ViewModel.HasBackgroundImage, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16"
                        Visibility="{x:Bind ViewModel.HasBackgroundImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Opacity" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Width="200" Minimum="0" Maximum="1"
                                    Value="{x:Bind ViewModel.BackgroundImageOpacity, Mode=TwoWay}"
                                    StepFrequency="0.05" Header="" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Image Fit" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.ImageFits}"
                                      SelectedItem="{x:Bind ViewModel.BackgroundImageFit, Mode=TwoWay}"
                                      MinWidth="150" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vertical Alignment" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.VerticalAlignments}"
                                      SelectedItem="{x:Bind ViewModel.BackgroundImageVerticalAlignment, Mode=TwoWay}"
                                      MinWidth="150" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Horizontal Alignment" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.HorizontalAlignments}"
                                      SelectedItem="{x:Bind ViewModel.BackgroundImageHorizontalAlignment, Mode=TwoWay}"
                                      MinWidth="150" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Startup" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7B5;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <!-- Consumer build: startup is always on -->
                            <TextBlock Text="Runs at Windows startup (always on)" FontWeight="SemiBold"
                                       Visibility="{x:Bind StartupViewModel.IsStartupAlwaysOnVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="At every login a banner drops down, runs your startup tasks and checks for updates — including right after an update, so new versions are picked up on the next boot."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Visibility="{x:Bind StartupViewModel.IsStartupAlwaysOnVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <!-- Dev/edit build: user can toggle startup on and off -->
                            <TextBlock Text="Run at Windows startup" FontWeight="SemiBold"
                                       Visibility="{x:Bind StartupViewModel.IsStartupToggleVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="A banner drops down at login, runs your startup tasks and checks for updates. Turn it off if you don't want that at boot."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Visibility="{x:Bind StartupViewModel.IsStartupToggleVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ToggleSwitch IsOn="{x:Bind StartupViewModel.RunAtStartup, Mode=TwoWay}"
                                          Visibility="{x:Bind StartupViewModel.IsStartupToggleVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Preview" Click="PreviewStartup_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Check for updates at startup" FontWeight="SemiBold" />
                                <TextBlock Text="The login banner also looks for a newer KalOS version and shows it."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind StartupViewModel.CheckUpdatesAtStartup, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>



                <TextBlock Text="Updates" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Visibility="{x:Bind ViewModel.IsUpdateFeatureVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16"
                        Visibility="{x:Bind ViewModel.IsUpdateFeatureVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="App updates" FontWeight="SemiBold" />
                            <TextBlock Text="KalOS checks GitHub Releases and updates itself in place when a new version is published."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                <FontIcon Glyph="&#xE896;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneTime}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ProgressRing Width="16" Height="16"
                                          IsActive="{x:Bind ViewModel.IsCheckingVisible, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsCheckingVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                          Margin="0,8,0,0" />

                            <TextBlock Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{x:Bind ViewModel.LastCheckedText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"
                                       Visibility="{x:Bind ViewModel.HasLastChecked, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <ProgressBar Maximum="1" Minimum="0"
                                         Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                         Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                            <ToggleSwitch Header="Check on startup"
                                          IsOn="{x:Bind ViewModel.AutoCheckForUpdates, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Check for updates"
                                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                                <Button Content="Download &amp; install"
                                        Command="{x:Bind ViewModel.DownloadAndInstallCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasUpdate, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <Button Content="Release history" Click="ShowReleaseHistory_Click"
                                    HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
                            <TextBlock Text="View the current session's activity log right here in the app. Full history and crash reports live in the Logs folder."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="View logs" Click="ViewLogs_Click" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16"
                        Visibility="{x:Bind ViewModel.IsFeatureCheckVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Feature check" FontWeight="SemiBold" />
                            <TextBlock Text="Verifies every KalOS feature is present in this build and shows the app version."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Run check" Click="FeatureCheck_Click" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8EC;" FontSize="18"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Third-party notices" FontWeight="SemiBold" />
                            <TextBlock Text="Licenses for the open-source components and brand assets KalOS uses."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="View" Click="ShowNotices_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
