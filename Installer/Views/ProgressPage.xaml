<local:WizardPage
    x:Class="KalOS.Setup.Views.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KalOS.Setup.Views"
    xmlns:vm="using:KalOS.Setup.ViewModels">

    <Grid Style="{StaticResource WizardPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="INSTALL" Style="{StaticResource ShellCaption}"/>
            <TextBlock Text="Installing" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="KalOS and your selections are being installed. Please keep this window open."/>
        </StackPanel>

        <!-- Current status card — stretches to fill the page so it reads as the
             main status surface; the step log sits at the bottom. -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24,28" Margin="0,0,0,20"
                MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Left"
                VerticalAlignment="Stretch">
            <StackPanel Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="StatusRing" IsActive="True" Width="32" Height="32" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Wizard.CurrentStep, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Bind Wizard.CurrentDetail, Mode=OneWay}" Style="{StaticResource BodyText}" FontSize="15"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Value="{x:Bind Wizard.OverallProgress, Mode=OneWay}" Maximum="100" CornerRadius="2" Height="6" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Wizard.ProgressPercentText, Mode=OneWay}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               MinWidth="42" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Step log -->
        <StackPanel Grid.Row="2" Spacing="8" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Left">
            <TextBlock Text="Steps" Style="{StaticResource SectionHeader}"/>
            <ListView x:Name="StepLogList" ItemsSource="{x:Bind Wizard.StepLog, Mode=OneWay}" SelectionMode="None"
                      MaxHeight="200"
                      ItemContainerStyle="{StaticResource StretchListViewItem}"
                      ContainerContentChanging="StepLogList_ContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstallStepLog">
                        <Border Style="{StaticResource CardStyle}" Margin="0,2">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="Glyph" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</local:WizardPage>
