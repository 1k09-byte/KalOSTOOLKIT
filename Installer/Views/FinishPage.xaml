<local:WizardPage
    x:Class="KaliteKit.Setup.Views.FinishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KaliteKit.Setup.Views">

    <Grid Style="{StaticResource WizardPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status hero -->
        <StackPanel Grid.Row="0" Spacing="10" MaxWidth="{StaticResource WizardContentMaxWidth}" HorizontalAlignment="Left">
            <TextBlock Text="FINISH" Style="{StaticResource ShellCaption}"/>
            <Viewbox Width="56" Height="56" HorizontalAlignment="Left">
                <FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" FontSize="48" Foreground="{ThemeResource SuccessBrush}"/>
            </Viewbox>
            <TextBlock x:Name="FinishTitle" Text="Installation complete" Style="{StaticResource PageTitle}" Margin="0,8,0,0"/>
            <TextBlock x:Name="FinishText" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Results card — stretches to the end of the page. -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24,20"
                MaxWidth="{StaticResource WizardContentMaxWidth}" HorizontalAlignment="Left"
                VerticalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Text="What was installed" Style="{StaticResource SectionHeader}"/>
                <ListView x:Name="ResultsList" SelectionMode="None" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource StretchListViewItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="CloseButton" Content="Close" Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</local:WizardPage>
