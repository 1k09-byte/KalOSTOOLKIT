<Page
    x:Class="KalOS.Views.AffinityManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KalOS.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <CollectionViewSource x:Name="DeviceGroups" IsSourceGrouped="True" />
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid>
            <StackPanel MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}"
                        Margin="{StaticResource PagePadding}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <!-- Page Header -->
                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <TextBlock Text="Per-CPU Scheduling &amp; MSI Manager" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Pin hardware interrupts to dedicated CPU cores for lower DPC latency, reduced jitter, and smooth frame pacing." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- CPU Topology Overview Card -->
                <controls:SettingsCard Header="{x:Bind ViewModel.CpuModelName, Mode=OneWay}"
                                       Description="{x:Bind ViewModel.CpuSummaryString, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7E8;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CpuPhysicalCores, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Cores" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE968;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CpuLogicalProcessors, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Threads" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:SettingsCard>

                
                <!-- Optimization Section -->
                <TextBlock Text="Automated Optimization" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard Header="Optimize System Affinities"
                                       Description="Apply intelligent low-latency CPU core pinning across GPU, USB, Audio, and Network devices based on CPU topology.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button Content="Optimize Affinities" Command="{x:Bind ViewModel.OptimizeAffinitiesCommand}" Style="{StaticResource AccentButtonStyle}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="Restore System Defaults"
                                       Description="Reset all affinity overrides and MSI limits back to default Windows operating system scheduling.">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE777;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button Content="Restore Defaults" Command="{x:Bind ViewModel.RestoreAllDefaultsCommand}" />
                </controls:SettingsCard>

                <!-- Search & Filtering Bar -->
                <Grid Margin="0,12,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             PlaceholderText="Search PCI devices by name or hardware ID..." 
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{x:Bind ViewModel.FilterCategories}" 
                              SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" 
                              MinWidth="180" />
                </Grid>

                <!-- Loading State -->
                <StackPanel Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="12">
                    <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Scanning PCI devices…" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- No devices State -->
                <StackPanel Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="8">
                    <TextBlock Text="No PCI devices found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="No devices match the current search query or filter." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Devices List -->
                <StackPanel Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <InfoBar Margin="0,4,0,16" IsOpen="{x:Bind ViewModel.HasHighCoreCount, Mode=OneWay}" Severity="Warning"
                             Title="High Core Count Detected (>64)" Message="Windows MSI Interrupts use a 64-bit mask. Only the first 64 logical processors are available for manual scheduling." IsClosable="False" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.GroupedDevices, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:PciDeviceGroup">
                                <StackPanel Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="1,16,0,8">
                                        <TextBlock Text="{x:Bind DisplayHeader, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:PciDeviceItem">
                                                <controls:SettingsCard Header="{x:Bind Name, Mode=OneWay}" Margin="0,0,0,4">
                                                    <controls:SettingsCard.HeaderIcon>
                                                        <FontIcon Glyph="{x:Bind Category, Converter={StaticResource CategoryToIconConverter}}" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    </controls:SettingsCard.HeaderIcon>
                                                    <controls:SettingsCard.Description>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{x:Bind MsiEnabledText, Mode=OneWay}" 
                                                                           Foreground="{x:Bind MsiEnabled, Converter={StaticResource MsiColorConverter}}" 
                                                                           FontSize="11" FontWeight="Medium" />
                                                            </Border>
                                                            <TextBlock Text="Limit:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind MsiLimit, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="Priority:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind DevicePriority, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="Policy:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind DevicePolicyDisplay, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </controls:SettingsCard.Description>
                                                    
                                                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <TextBlock Text="Assigned Cores" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{x:Bind CoresAssignedDisplay, Mode=OneWay}" FontWeight="Medium" FontSize="12" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                        <Button Content="Edit" Click="CardButton_Click" Tag="{Binding}" />
                                                    </StackPanel>
                                                </controls:SettingsCard>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

