<ContentDialog
    x:Class="KalOS.Views.NvInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NVIDIA Driver — Select Driver Version To Install"
    PrimaryButtonText="Next"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource RoundedContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">740</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MaxHeight="640">

        <!-- Hardware info (mirrors NVCleanstall's first screen) -->
        <Grid RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Graphics Hardware:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HardwareText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Current Driver:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CurrentDriverText" FontSize="12" FontWeight="SemiBold" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Package:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="14">
                <TextBlock x:Name="DchText" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="64-Bit: Yes" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="MobileText" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="Studio: No" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Driver source -->
        <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" FontSize="13" Text="Driver source" />

            <RadioButton x:Name="RbBestDriver" GroupName="nvSource" IsChecked="True">
                <StackPanel Spacing="2">
                    <TextBlock Text="Install best driver for my hardware" FontSize="12.5" />
                    <TextBlock x:Name="BestDriverLabel" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbManualVersion" GroupName="nvSource"
                         Checked="SourceRadio_Changed" Unchecked="SourceRadio_Changed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Manually select a driver version" FontSize="12.5" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="VersionCombo" IsEnabled="False" MinWidth="340" FontSize="12"
                                  SelectionChanged="VersionCombo_SelectionChanged" />
                        <CheckBox x:Name="CbShowAllVersions" Content="Show more" IsEnabled="False"
                                  FontSize="11.5" VerticalAlignment="Center" Checked="ShowAllVersions_Changed" Unchecked="ShowAllVersions_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="VersionListHint" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbDriverOnDisk" GroupName="nvSource"
                         Checked="SourceRadio_Changed" Unchecked="SourceRadio_Changed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Use driver files on disk" FontSize="12.5" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="DiskPathBox" PlaceholderText="Path to the downloaded driver .exe" IsEnabled="False" MinWidth="420" FontSize="12" />
                        <Button Grid.Column="1" x:Name="BrowseBtn" Content="Browse…" IsEnabled="False" Click="Browse_Click" />
                    </Grid>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Components -->
        <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" FontSize="13" Text="Select Components To Install" />
            <TextBlock Text="The display driver is always installed — the stock installer is never run: the package is extracted, stripped, and staged via pnputil, then container services, telemetry tasks, and stale driver-store packages are removed (clean-install grade)."
                       TextWrapping="Wrap" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MaxWidth="620" />
            <StackPanel Spacing="4">
                <CheckBox Content="Display Driver (required)" IsChecked="True" IsEnabled="False" />
                <CheckBox x:Name="CbHdAudio" Content="HD Audio via HDMI" />
                <CheckBox x:Name="CbMsvc" Content="Microsoft Visual C 2017 Runtimes" />
                <CheckBox x:Name="CbPhysX" Content="PhysX" />
                <CheckBox x:Name="CbUSBC" Content="USB-C Driver" />
                <CheckBox x:Name="CbFrameView" Content="FrameView SDK" />
                <CheckBox x:Name="CbVirtualAudio" Content="Virtual Audio" />
                <CheckBox x:Name="CbTelemetry" Content="Telemetry (not recommended)" />
                <CheckBox x:Name="CbNvPlatformControllers" Content="NV Platform Controllers" />
                <CheckBox x:Name="CbDlsr" Content="NVIDIA DLSR" />

                <TextBlock Text="NV App Components" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" Opacity="0.8" />
                <CheckBox x:Name="CbNvApp" Content="NVIDIA App" />
                <CheckBox x:Name="CbNvContainer" Content="NV Container" />
                <CheckBox x:Name="CbShadowPlay" Content="ShadowPlay" />
                <CheckBox x:Name="CbNvBackend" Content="NV Backend" />
                <CheckBox x:Name="CbMessageBus" Content="NVIDIA App MessageBus" />
            </StackPanel>
        </StackPanel>

        <!-- Progress -->
        <ProgressBar x:Name="Progress" IsIndeterminate="False" Value="0" Minimum="0" Maximum="100" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="A reboot is recommended after the install." />

    </StackPanel>
</ContentDialog>
