<local:WizardPage
    x:Class="KalOS.Setup.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KalOS.Setup.Views">

    <Grid Style="{StaticResource WizardPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="TWEAKS &amp; CLEANUP" Style="{StaticResource ShellCaption}"/>
            <TextBlock Text="Tweaks &amp; Cleanup" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{x:Bind Wizard.TweakSubtitle, Mode=OneWay}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Spacing="16" MaxWidth="{StaticResource WizardContentMaxWidth}" HorizontalAlignment="Left">

                <!-- Master switch -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <CheckBox x:Name="ApplyTweaksCheck" Content="Apply tweaks &amp; cleanup after the install"
                                  IsChecked="{x:Bind Wizard.ApplyTweaks, Mode=TwoWay}"
                                  Checked="ApplyTweaksCheck_Changed" Unchecked="ApplyTweaksCheck_Changed"/>
                        <TextBlock x:Name="SkipNote" Style="{StaticResource CardSubtitle}"
                                   Text="No tweaks will be applied — KalOS and your selected software only." Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="WarnBar" IsOpen="True" Severity="Warning" IsClosable="False"
                         Title="Tweaks by privacy.sexy — nothing is removed from your Windows ISO"
                         Message="Every tweak here is reversible: removed apps can be reinstalled from the Microsoft Store and disabled features, services and tasks can be re-enabled in Windows Settings — nothing is baked out of your Windows image. Some changes only fully apply after a restart."/>

                <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                         Title="This step can take a while"
                         Message="Tweaks &amp; cleanup runs hundreds of changes (app removals, Windows capabilities, services) and is often the slowest part of the install — several minutes is normal, and the progress bar can sit near 100% while a slow Windows operation finishes. It is not stuck."/>

                <!-- Credit line -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Credits: privacy.sexy" Style="{StaticResource CardHeader}"/>
                        <TextBlock Style="{StaticResource CardSubtitle}"
                                   Text="The tweak catalog is generated from privacy.sexy (privacy.sexy) — the open-source Windows privacy configuration tool — and runs natively inside this installer. No batch scripts are executed."/>
                    </StackPanel>
                </Border>

                <!-- Category checklist -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="What to apply" Style="{StaticResource CardHeader}"/>
                        <TextBlock Style="{StaticResource CardSubtitle}"
                                   Text="Everything is checked by default — the same set your scripts ran. Uncheck a category to leave that part of Windows alone."/>
                        <StackPanel x:Name="CategoryList" Spacing="6" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0"
                                          Content="{x:Bind Wizard.TweakAppsLabel, Mode=OneWay}"
                                          IsChecked="{x:Bind Wizard.TweakApps, Mode=TwoWay}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0"
                                          Content="{x:Bind Wizard.TweakFeaturesLabel, Mode=OneWay}"
                                          IsChecked="{x:Bind Wizard.TweakFeatures, Mode=TwoWay}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0"
                                          Content="{x:Bind Wizard.TweakPrivacyLabel, Mode=OneWay}"
                                          IsChecked="{x:Bind Wizard.TweakPrivacy, Mode=TwoWay}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0"
                                          Content="{x:Bind Wizard.TweakServicesLabel, Mode=OneWay}"
                                          IsChecked="{x:Bind Wizard.TweakServices, Mode=TwoWay}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0"
                                          Content="{x:Bind Wizard.TweakHistoryLabel, Mode=OneWay}"
                                          IsChecked="{x:Bind Wizard.TweakHistory, Mode=TwoWay}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0"
                                          Content="{x:Bind Wizard.TweakLogsLabel, Mode=OneWay}"
                                          IsChecked="{x:Bind Wizard.TweakLogs, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                         Title="Runs at the very end of the install"
                         Message="Tweaks are applied last — after KalOS, drivers, software and extensions — so history and log cleanup also covers this install's own tracks."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:WizardPage>
