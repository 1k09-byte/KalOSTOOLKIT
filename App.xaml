<Application
    x:Class="KalOS.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KalOS"
    xmlns:services="using:KalOS.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Order matters and explicitly loaded for the first time:
                      1. XamlControlsResources — WinUI built-in styles (Standard*Style, NavigationViewItemPresenter, etc.).
                      2. Styles/Brushes.xaml — theme brushes that AppStyles.xaml references via {ThemeResource ...}.
                      3. Styles/AppStyles.xaml — page-level styles and shared typography.
                      4. Styles/CommonStyles.xaml — shared spacings, transitions, converters, and per-ListView stretch style.
                    Skipping 2 or 3 here means any {StaticResource ...}/{ThemeResource ...} chain that crosses those
                    files throws XamlParseException at app startup.
                -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Brushes.xaml" />
                <ResourceDictionary Source="Styles/AppStyles.xaml" />
                <ResourceDictionary Source="Styles/CommonStyles.xaml" />
                <!-- The embedded setup wizard's styles (compiled from Installer/ into
                     this app). Keys that would collide with the consumer shell's own
                     (PageContentMaxWidth, PagePadding, BoolToVis ...) are renamed to
                     Wizard* in that dictionary, so this merge is collision-free. -->
                <ResourceDictionary Source="ms-appx:///Installer/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
