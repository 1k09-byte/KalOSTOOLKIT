<Page
    x:Name="RootPage"
    x:Class="KalOS.Views.WindhawkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid>
            <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource SettingsCardSpacing}" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <Button Click="BackButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Windhawk" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Configured automatically during setup — no manual steps needed."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <controls:SettingsCard Header="Application Status"
                                       Description="{x:Bind ViewModel.StatusText, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE930;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </controls:SettingsCard.HeaderIcon>
                    <Border Style="{StaticResource StatusBadgeStyle}">
                        <TextBlock Text="{x:Bind ViewModel.InstalledStateText, Mode=OneWay}" FontSize="12" />
                    </Border>
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
