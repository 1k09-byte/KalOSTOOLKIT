<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Semantic color layer — stripped down for a pure Windows 11 Settings app look.
        We rely 100% on the platform's built-in ThemeResource brushes for all surfaces.
        Only keeping core branding and semantic status colors.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Brand Accent -->
            <Color x:Key="AccentColor">#60CDFF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#0F0F0F" />

            <!-- Core Status Colors (Native WinUI 3 Palette) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="InfoBrush" Color="#60CDFF" />
            
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9D9D9D" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AccentColor">#0078D4</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="InfoBrush" Color="#0067C0" />
            
            <SolidColorBrush x:Key="MutedTextBrush" Color="#5C5C5C" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
