<Page
    x:Class="KaliteKit.Views.AffinityManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KaliteKit.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <CollectionViewSource x:Name="DeviceGroups" IsSourceGrouped="True" />
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <Grid>
            <!-- Wider content column than the global 1000px cap: device names,
                 the search box, and the 7-column table all get room to breathe. -->
            <StackPanel MaxWidth="1400" HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}"
                        Margin="{StaticResource PagePadding}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <!-- ══════════════════════════════════════════════════════
                     Hero header: title + live status + stat pills
                     ══════════════════════════════════════════════════════ -->
                <StackPanel Spacing="4" Margin="0,0,0,4">
                    <TextBlock Text="Per-CPU Scheduling" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Pin interrupt-heavy devices to dedicated CPU cores for lower latency." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Spacing="8" Margin="2,0,0,10">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource StatusBadgeStyle}" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalDevices, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="devices" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusBadgeStyle}" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.MsiEnabledCount, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="MSI on" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusBadgeStyle}" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PinnedCount, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="pinned" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusBadgeStyle}" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CpuCoreCount, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="cores" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════
                     CPU topology summary card
                     ══════════════════════════════════════════════════════ -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12"
                        Visibility="{x:Bind ViewModel.TopologySummary, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.TopologySummary.CpuName, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.TopologySummary.Describe(), Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopologySummary.Groups, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:CpuCoreGroup">
                                    <Border Style="{StaticResource StatusBadgeStyle}" Padding="10,4"
                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{x:Bind Kind, Converter={StaticResource CoreKindColorConverter}}" />
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind ThreadCount}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════
                     Search + category filter row
                     ══════════════════════════════════════════════════════ -->
                <Grid ColumnSpacing="8" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="Search devices or hardware IDs…"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton x:Name="ChipAll"      Content="All"     Tag="All"     Click="CategoryChip_Click" Padding="10,3" FontSize="12" />
                        <ToggleButton x:Name="ChipGpu"      Content="GPU"     Tag="GPU"     Click="CategoryChip_Click" Padding="10,3" FontSize="12" />
                        <ToggleButton x:Name="ChipAudio"    Content="Audio"   Tag="Audio"   Click="CategoryChip_Click" Padding="10,3" FontSize="12" />
                        <ToggleButton x:Name="ChipNetwork"  Content="Network" Tag="Network" Click="CategoryChip_Click" Padding="10,3" FontSize="12" />
                        <ToggleButton x:Name="ChipXhci"     Content="XHCI"    Tag="XHCI"    Click="CategoryChip_Click" Padding="10,3" FontSize="12" />
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════════════════════
                     Action toolbar: rescan / restore defaults / optimize
                     ══════════════════════════════════════════════════════ -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.LoadDevicesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Rescan" />
                            </StackPanel>
                        </Button>
                        <Button Click="RestoreAll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="Restore System Defaults" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.OptimizeAffinitiesCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE946;" FontSize="14" />
                                <TextBlock Text="Optimize" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Elevation gate: writes go to HKLM, so without admin they fail -->
                <InfoBar Severity="Warning"
                         Title="Administrator required"
                         Message="MSI and affinity settings live in HKLM — without elevation, applying changes will fail."
                         IsClosable="False"
                         IsOpen="True"
                         Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />

                <!-- Loading State -->
                <StackPanel Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="12">
                    <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Scanning PCI devices…" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- No devices State -->
                <StackPanel Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="8">
                    <FontIcon Glyph="&#xE7F4;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No MSI-capable devices detected" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="This system doesn't expose any PCI devices that support MSI messaging." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════
                     Table: header row + grouped device rows
                     ══════════════════════════════════════════════════════ -->
                <StackPanel Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <InfoBar Margin="0,4,0,12" IsOpen="{x:Bind ViewModel.HasHighCoreCount, Mode=OneWay}" Severity="Warning"
                             Title="High Core Count Detected (>64)" Message="Windows MSI Interrupts use a 64-bit mask. Only the first 64 logical processors are available for manual scheduling." IsClosable="False" />

                    <!-- Column headers -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8,8,0,0" Padding="12,8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Device" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="MSI Mode" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="MSI Limit" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Priority" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Policy" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="Assigned" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.GroupedDevices, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:PciDeviceGroup">
                                <StackPanel>
                                    <!-- Group band -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1,0,1,1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="1.0*" />
                                                <ColumnDefinition Width="0.7*" />
                                                <ColumnDefinition Width="0.9*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Key, Converter={StaticResource CategoryToIconConverter}}"
                                                          FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind DisplayHeader, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource StatusBadgeStyle}" Padding="6,1">
                                                    <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:PciDeviceItem">
                                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="0,0,0,1" Padding="12,10">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.2*" />
                                                            <ColumnDefinition Width="1.0*" />
                                                            <ColumnDefinition Width="0.7*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="72" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Device: icon + name, threads/policy as subtitle -->
                                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <FontIcon Glyph="{x:Bind Category, Converter={StaticResource CategoryToIconConverter}}"
                                                                      FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                <TextBlock Text="{x:Bind AssignmentSubtitle, Mode=OneWay}" FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- MSI badge: green when on, red when off -->
                                                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon FontSize="10" VerticalAlignment="Center"
                                                                          Glyph="{x:Bind MsiEnabled, Converter={StaticResource MsiGlyphConverter}}"
                                                                          Foreground="{x:Bind MsiEnabled, Converter={StaticResource MsiColorConverter}}" />
                                                                <TextBlock Text="{x:Bind MsiEnabledText, Mode=OneWay}" FontSize="11"
                                                                           Foreground="{x:Bind MsiEnabled, Converter={StaticResource MsiColorConverter}}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- MSI limit badge -->
                                                        <Border Grid.Column="2" Style="{StaticResource StatusBadgeStyle}" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{x:Bind MsiLimitShort, Mode=OneWay}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        </Border>

                                                        <!-- Priority chip -->
                                                        <Border Grid.Column="3" Style="{StaticResource StatusBadgeStyle}" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{x:Bind DevicePriority, Mode=OneWay}" FontSize="11"
                                                                       Foreground="{x:Bind DevicePriority, Converter={StaticResource PriorityColorConverter}}" />
                                                        </Border>

                                                        <!-- Policy badge -->
                                                        <Border Grid.Column="4" Style="{StaticResource StatusBadgeStyle}" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{x:Bind DevicePolicyShort, Mode=OneWay}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>

                                                        <!-- Assigned cores badge -->
                                                        <Border Grid.Column="5" Style="{StaticResource StatusBadgeStyle}" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE968;" FontSize="10" VerticalAlignment="Center"
                                                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                                <TextBlock Text="{x:Bind AssignedCoresShort, Mode=OneWay}" FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Edit action -->
                                                        <Button Grid.Column="6" Content="Edit" Click="CardButton_Click" Tag="{Binding}"
                                                                VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
