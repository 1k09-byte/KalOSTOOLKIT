<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>KalOS.Installer</AssemblyName>
    <RootNamespace>KalOS.Installer</RootNamespace>
    <Version>1.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Ship exactly one exe: every referenced assembly (System.IO.Compression,
         Microsoft.CSharp) is in the .NET Framework 4.8 GAC that ships with
         Windows 10/11, so the bootstrapper runs with zero prerequisites —
         which is the point: its job is to check/install the .NET 9 runtime
         the main app needs, so it cannot itself require .NET 9. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
