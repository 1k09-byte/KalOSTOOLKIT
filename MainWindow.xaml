<winuiex:WindowEx
    x:Class="KalOS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    mc:Ignorable="d"
    Title="KalOS"
    Width="1200"
    Height="820"
    MinWidth="900"
    MinHeight="620">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Background image layer (behind everything) -->
        <Image x:Name="BackgroundImage"
               Grid.Row="0" Grid.RowSpan="2"
               Stretch="UniformToFill"
               Opacity="0.5"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Collapsed" />

        <!-- Semi-transparent overlay to keep content readable -->
        <Grid x:Name="BackgroundOverlay"
              Grid.Row="0" Grid.RowSpan="2"
              Background="#80000000"
              Visibility="Collapsed" />

        <!-- Title bar -->
        <TitleBar x:Name="AppTitleBar"
                   Grid.Row="0"
                   Title="KalOS"
                   IsPaneToggleButtonVisible="True"
                   PaneToggleRequested="AppTitleBar_PaneToggleRequested" />

        <!-- Navigation shell — flattened to 2 levels max -->
        <NavigationView x:Name="NavView"
                         Grid.Row="1"
                         PaneDisplayMode="Auto"
                         CompactModeThresholdWidth="641"
                         ExpandedModeThresholdWidth="1008"
                         IsPaneOpen="True"
                         IsPaneToggleButtonVisible="False"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         OpenPaneLength="260"
                         CompactPaneLength="48"
                         ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <!-- ─── Overview ─── -->
                <NavigationViewItem Content="Home" Tag="Home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Optimize" />
                <NavigationViewItem Content="System Overview" Tag="SystemOverview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Process Control" Tag="ProcessControl">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Per-CPU Scheduling" Tag="AffinityManager">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Install &amp; Update" />
                <NavigationViewItem Content="Driver Store" Tag="DriverStore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE965;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Browsers &amp; Software" Tag="Browsers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="GPU Drivers" Tag="GpuDrivers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Other Drivers" Tag="Sdio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Tune &amp; Personalize" />
                <NavigationViewItem Content="BIOS Manager" Tag="Bios">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Additional Tweaks" Tag="AdditionalTweaks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Personalization" Tag="Personalization">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" PointerWheelChanged="ContentFrame_PointerWheelChanged"
                   ContentTransitions="{StaticResource PageNavigationTransition}" />
        </NavigationView>

        <!-- Full-window modal overlay container for perfectly centered custom dialogs -->
        <Grid x:Name="AppModalOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Background="#80000000"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <ContentControl x:Name="AppModalContent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>

    </Grid>
</winuiex:WindowEx>
