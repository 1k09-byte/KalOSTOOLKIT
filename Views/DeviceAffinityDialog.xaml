<ContentDialog
    x:Class="KalOS.Views.DeviceAffinityDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KalOS.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:sys="using:System"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.DeviceName, Mode=OneWay}"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    PrimaryButtonClick="SaveClick"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <CornerRadius x:Key="OverlayCornerRadius">24</CornerRadius>
    </ContentDialog.Resources>

    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.DeviceId, Mode=OneWay}" 
                   Style="{StaticResource CaptionTextBlockStyle}" 
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                   TextWrapping="Wrap" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1" Margin="0,0,0,0" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="14">

                <!-- ══════════════════════════════════════════════════════
                     MSI Policies
                     ══════════════════════════════════════════════════════ -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2" Text="MSI Policies — Message Signaled Interrupts" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2" />

                        <!-- MSI Mode -->
                        <StackPanel Grid.Row="1" Grid.Column="0" MinHeight="56" VerticalAlignment="Top" Spacing="2" Margin="0,6">
                            <TextBlock Text="MSI Mode" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Message-signaled interrupts reduce CPU overhead compared to legacy line-based IRQs."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Enabled" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{x:Bind ViewModel.MsiEnabled, Mode=TwoWay}" />

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- MSI Limit -->
                        <StackPanel Grid.Row="3" Grid.Column="0" MinHeight="56" VerticalAlignment="Top" Spacing="2" Margin="0,6">
                            <TextBlock Text="MSI Limit" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.MsiLimitDescription, Mode=OneWay}"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <NumberBox Width="140" Value="{x:Bind ViewModel.MsiLimit, Mode=TwoWay}"
                                       Minimum="1" Maximum="{x:Bind ViewModel.MaxMsiLimit}"
                                       SpinButtonPlacementMode="Inline"
                                       IsEnabled="{x:Bind ViewModel.MsiEnabled, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.MaxMsiLimitText}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════
                     Advanced Policies
                     ══════════════════════════════════════════════════════ -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2" Text="Advanced Policies" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.PolicyDescription, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />

                        <!-- Device Priority -->
                        <StackPanel Grid.Row="2" Grid.Column="0" MinHeight="56" VerticalAlignment="Top" Spacing="2" Margin="0,6">
                            <TextBlock Text="Device Priority" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="How urgently the device's interrupts are serviced relative to other hardware."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.Priorities}"
                                  SelectedItem="{x:Bind ViewModel.DevicePriority, Mode=TwoWay}" />

                        <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Device Policy -->
                        <StackPanel Grid.Row="4" Grid.Column="0" MinHeight="56" VerticalAlignment="Top" Spacing="2" Margin="0,6">
                            <TextBlock Text="Device Policy" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Controls which processors are eligible to receive the device's interrupts."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Row="4" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.Policies}"
                                  SelectedItem="{x:Bind ViewModel.DevicePolicy, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════
                     Processor Mask
                     ══════════════════════════════════════════════════════ -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,16">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="16" Padding="0,12">
                            <FontIcon Glyph="&#xE968;" FontSize="16" />
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Processor Mask (P-Cores)" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource StatusBadgeStyle}" Padding="6,1">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSummary, Mode=OneWay}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Assign hardware interrupts to specific logical processors" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel Padding="4,12">
                            <!-- Mask toolbar -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,0,16,12">
                                <Button Content="Select all" Click="SelectAllThreads_Click" />
                                <Button Content="Clear" Click="ClearThreads_Click" />
                            </StackPanel>

                            <GridView ItemsSource="{x:Bind ViewModel.Cores}" SelectionMode="None">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:CpuCoreInfo">
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,12" Width="170" Padding="0,0,0,10">
                                            <StackPanel>
                                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,9" CornerRadius="8,8,0,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE964;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{x:Bind Threads}" Margin="12,10,12,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewmodels:CpuThreadInfo">
                                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,0,0,4">
                                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="12" />
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
